DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memseek
MEMSEEK_BUILD_SHA=dev

# LLM/provider seam. Endpoints, models, and the embedding model are declared in
# conf/models.yaml. Only credentials live here: each provider entry names the
# variable holding its key via api_key_env, so add one line per endpoint you use.
MODELS_FILE=./conf/models.yaml
OPENAI_API_KEY=
# A second endpoint declared in models.yaml supplies its own variable name, e.g.
# VOYAGE_API_KEY= for an embedding provider hosted somewhere else.
LLM_FAKE=0
# Log every model request (system + prompt + params) and its raw response at
# DEBUG for derivations and processors, WITHOUT redaction. Local debugging only.
LLM_DEBUG=0
LLM_MAX_CONCURRENCY=8
MODEL_CONTEXT_TOKENS=60000
MAX_PROMPT_TOKENS=50000
MAX_OUTPUT_TOKENS=4000

SCORERS_FILE=./conf/scorers.yaml
ANNOTATION_PROCESSORS_FILE=./conf/annotation_processors.yaml
# Catalog definitions are NOT loaded by default, and these are left unset on
# purpose: a workspace gets its catalog by publishing one. Point them at a
# catalog directory only if you want this process to compile definitions of
# its own at startup — `resources/` holds the reference catalog:
#   COLLECTIONS_DIR=./resources/collections
#   TRIGGERS_DIR=./resources/triggers
#   VIEWS_DIR=./resources/views
#   ARTIFACTS_DIR=./resources/artifacts
#   PACKAGES_DIR=./resources/packages
#   MCP_DIR=./resources/mcp
#   DERIVATIONS_DIR=./resources/derivations
#   PROCESSORS_FILE=./resources/conf/processors.yaml

# Search. SEARCH_BACKEND remains the default profile shorthand.
SEARCH_PROFILES_FILE=./conf/search_profiles.yaml
SEARCH_BACKEND=pg
RANK_DEFAULT_FILE=./conf/rank_default.yaml
SEARCH_PROFILE_OVERRIDES_FILE=
TOUCH_ON_READ=1
RRF_RANK_CONSTANT=60
MAX_COLLECTION_FANOUT=8
SEARCH_MAX_CONCURRENCY=8

TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1
TURBOPUFFER_BASE_URL=
TURBOPUFFER_LAYOUT=shared
TURBOPUFFER_CONSISTENCY=strong

# Pipeline limits.
# JSON list of trusted Python modules imported by catalog, API, and worker startup.
TASK_MODULES=["memseek.derive.tasks_graph"]
ENRICH_BATCH=32
ENRICH_LLM_BATCH=16
SCORER_TEXT_CHARS=12000
MAX_BATCH=100
MAX_TEXT_CHARS=65536
MAX_CONTENT_BYTES=131072
MAX_ANNOTATION_BYTES=32768
MAX_ARTIFACT_RENDER_TOKENS=50000
MAX_ARTIFACT_INPUT_RECORDS=255
MAX_RUN_CONTENT_BYTES=262144
MAX_DERIVATION_CONFIG_BYTES=65536
MAX_DERIVED_FROM=256
MAX_RESPONSE_BYTES=4194304
MAX_DOCUMENT_RECORDS=500
MAX_QUERY_CHARS=8192
SEARCH_RENDER_TOKENS=16000
MAX_CITATIONS_PER_OUTPUT=64
MAX_DERIVATION_DEPTH=4
MAX_GRAPH_DEPTH=4
MAX_GRAPH_PATHS=100
MAX_STEP_CONCURRENCY=5
MAX_RUN_TOTAL_TOKENS=100000
MAX_RUN_WALL_S=180

# Worker and queue.
WORKER_POLL_MS=500
WORKER_CONCURRENCY=4
INDEX_CONCURRENCY=1
JOB_LEASE_S=300
JOB_HEARTBEAT_S=60
JOB_MAX_ATTEMPTS=3
UNREADY_RETRY_S=2
CRON_TICK_S=30
MAX_CRON_CATCHUP=100

# Optional advisory contradiction checker.
CONTEXT_DOC_ORDER_SCORE=importance

# Artifact uses are correlation handles, not durable history: retention bounds
# how long delayed feedback can still name one render. The learning signals that
# feedback produces are ordinary records and outlive the handle.
ARTIFACT_USE_RETENTION_DAYS=90
ARTIFACT_USE_PURGE_BATCH=500
MAX_FEEDBACK_COMMENT_CHARS=2000
MAX_FEEDBACK_EVIDENCE_CHARS=4000

# API process and hash-only authentication cache.
API_HOST=127.0.0.1
API_PORT=8000
# Browser origins allowed to send bearer-authenticated requests to this API or
# /mcp: one origin, several separated by commas, or a JSON array. Exact origins
# only; wildcards are rejected. CLI MCP clients omit Origin, so remote Claude
# Code and Codex connections do not need an entry here.
# API_CORS_ORIGINS=http://localhost:4321
API_KEY_CACHE_TTL_S=60
API_KEY_CACHE_SIZE=1024
