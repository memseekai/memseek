---
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Hub for the interactive showcases. The showcases themselves are hand-written,
 * self-contained HTML in public/showcase/<slug>/index.html — Astro copies them
 * verbatim and never parses them, so they keep their own styling and scripts.
 * Adding one is two steps: drop the file in public/, add a row here.
 */
/**
 * MemBukkit and the workspace explorer are things readers can use, rather than
 * worked memory stories, so they get their own category on the hub.
 */
const projectsAndTools = [
  {
    href: '/membukkit/',
    slug: 'membukkit',
    kind: 'open agent-memory project',
    title: 'MemBukkit',
    blurb: 'Rent changes from €800 to €950. Ask what is true now—or what was true before.',
    status: 'runnable · separate repository',
    action: 'Explore project →',
    accent: 'var(--orange)',
  },
  {
    slug: 'workspace-explorer',
    kind: 'live workspace tool',
    title: 'The workspace explorer',
    blurb: 'Connect a workspace and follow definitions, records, runs, views, and outputs.',
    status: 'live · read-only connection',
    action: 'Open explorer →',
    accent: 'var(--cyan)',
  },
];

/**
 * One card per memory story. `kind` deliberately describes the visible change
 * in plain language instead of asking a new reader to know memory-system jargon.
 * `status` says whether the destination is runnable or a blueprint.
 */
const showcases = [
  {
    slug: 'agent-memory',
    kind: 'conversation → memory',
    title: 'The agent memory reactor',
    blurb: 'Watch Alice’s migration rules become facts, project context, and a safer answer.',
    status: 'simulation + runnable example',
    accent: 'var(--green)',
  },
  {
    slug: 'generative-agents',
    kind: 'agents remember events',
    title: 'Generative agents',
    blurb: 'Follow a party rumor, an overnight reflection, and a correction across three days.',
    status: 'simulation + runnable example',
    accent: 'var(--violet)',
  },
  {
    slug: 'gbrain',
    kind: 'pages → knowledge',
    title: 'An entire brain, declared',
    blurb: 'Five Markdown pages become a graph, fact index, durable memory, and cited answers.',
    status: 'simulation + runnable example',
    accent: 'var(--orange)',
  },
  {
    slug: 'self-audit',
    kind: 'beliefs challenge themselves',
    title: 'The self-auditing mind',
    blurb: 'Two reasonable strategies collide, and every belief opens back to its evidence.',
    status: 'simulation + runnable example',
    accent: 'var(--pink)',
  },
  {
    slug: 'dreams',
    kind: 'clean up memory',
    title: 'dreams × memseek',
    blurb: 'Merge duplicates, replace stale memory, and review the proposed store as a diff.',
    status: 'design simulation · blueprint',
    accent: 'var(--amber)',
  },
  {
    slug: 'living-profile',
    kind: 'events → current profile',
    title: 'The living profile',
    blurb: 'Four CRM events become one current profile, with evidence behind every field.',
    status: 'simulation + runnable example',
    accent: 'var(--cyan)',
  },
  {
    slug: 'skill',
    kind: 'feedback → better playbook',
    title: 'The maintained skill',
    blurb: 'A bad refund rule produces a cited replacement that only a person can approve.',
    status: 'simulation + runnable example',
    accent: 'var(--green)',
  },
  {
    slug: 'mcp',
    kind: 'memory tools for agents',
    title: 'Plug it into an existing agent',
    blurb: 'Turn a five-item allowlist into safe search, calendar, prompt, and citation tools.',
    status: 'simulation + runnable example',
    accent: 'var(--violet)',
  },
];
---

<BaseLayout
  title="Showcases — Memseek"
  description="Scroll-driven case studies of the Memseek context engine, with the modeled problem, YAML contract, resulting writes, and evidence trail made explicit."
>
  <section class="sc-hero">
    <div class="wrap">
      <span class="eyebrow">Showcases</span>
      <h1>See how it <span class="grad">runs.</span></h1>
      <p class="lede">
        Try an open project, inspect a live workspace, or pick a familiar memory case. The tools
        let you explore directly; the showcases unfold each event, write, and evidence trail as
        you scroll.
      </p>
      <p class="simulation-note">
        <strong>About the showcase cases.</strong> Their people, events, conversations, and
        outputs are illustrative examples, not live customer records or captured customer
        activity. The workspace explorer says explicitly when you choose to connect live data.
      </p>
    </div>
  </section>

  <section class="sc-list">
    <div class="wrap categories">
      <div class="category">
        <div class="category-heading">
          <h2>Projects &amp; tools</h2>
          <p>Runnable ways to try the memory system or inspect what a workspace contains.</p>
        </div>
        <div class="grid">
          {projectsAndTools.map((item) => (
            <article class="card" style={`--hue: ${item.accent}`}>
              <a href={item.href ?? `/showcase/${item.slug}/`} class="hit" aria-label={item.title}></a>
              <div class="body">
                <span class="kind">{item.kind}</span>
                <h3>{item.title}</h3>
                <p>{item.blurb}</p>
                <span class="status">{item.status}</span>
                <span class="read">{item.action}</span>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="category">
        <div class="category-heading">
          <h2>Showcases</h2>
          <p>Worked memory cases that make each transformation and its evidence visible.</p>
        </div>
        <div class="grid">
          {showcases.map((showcase) => (
            <article class="card" style={`--hue: ${showcase.accent}`}>
              <a href={`/showcase/${showcase.slug}/`} class="hit" aria-label={showcase.title}></a>
              <div class="body">
                <span class="kind">{showcase.kind}</span>
                <h3>{showcase.title}</h3>
                <p>{showcase.blurb}</p>
                <span class="status">{showcase.status}</span>
                <span class="read">Open case →</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sc-hero { position: relative; padding-top: clamp(2.4rem, 5vw, 4rem); padding-bottom: clamp(1.6rem, 3vw, 2.4rem); overflow: hidden; }
  .sc-hero::before {
    content: ""; position: absolute; inset: -60% -10% auto; height: 460px; z-index: 0; pointer-events: none;
    background:
      radial-gradient(38% 60% at 18% 40%, color-mix(in srgb, var(--orange) 26%, transparent), transparent 70%),
      radial-gradient(38% 56% at 62% 20%, color-mix(in srgb, var(--violet) 22%, transparent), transparent 72%);
    opacity: .85;
  }
  .sc-hero .wrap { position: relative; z-index: 1; }
  .sc-hero h1 { font-size: var(--step-3); margin-top: 1.1rem; max-width: 16ch; }
  .lede { color: var(--muted); max-width: 48ch; margin-top: 1.1rem; }
  .simulation-note {
    max-width: 62ch; margin-top: 1rem; padding: .8rem .95rem;
    border: 1px solid color-mix(in srgb, var(--orange) 28%, var(--border));
    border-left: 3px solid var(--orange); border-radius: 8px;
    background: color-mix(in srgb, var(--orange) 6%, var(--surface));
    color: var(--muted); font-size: var(--step--1); line-height: 1.55;
  }
  .simulation-note strong {
    color: var(--text); font-family: var(--mono); font-size: .68rem;
    letter-spacing: .08em; text-transform: uppercase;
  }

  .sc-list { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .categories { display: flex; flex-direction: column; gap: clamp(2.6rem, 6vw, 4.8rem); }
  .category { display: flex; flex-direction: column; gap: 1.2rem; }
  .category-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; }
  .category-heading h2 { font-size: var(--step-2); }
  .category-heading p { max-width: 35rem; color: var(--muted); font-size: .93rem; }
  /* Narrower track than the old blurb needed: one sentence per card reads better
     three-across than two. */
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: 1rem; }

  .card {
    position: relative;
    border: 1px solid var(--border); border-radius: 14px;
    background: var(--surface); box-shadow: var(--shadow);
    overflow: hidden; display: flex; flex-direction: column;
    transition: border-color .18s, transform .18s;
  }
  .card::before { content: ""; position: absolute; inset: 0 0 auto; height: 2px; background: var(--hue); }
  .card:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  /* One stretched link keeps the whole card clickable without nesting anchors. */
  .hit { position: absolute; inset: 0; z-index: 2; }

  .body { padding: 1.3rem 1.3rem 1.15rem; display: flex; flex-direction: column; gap: .5rem; flex: 1; }
  /* The memory kind, not the URL: it is the one label that tells a reader
     whether this card is the thing they came looking for. */
  .kind {
    font-family: var(--mono); font-size: .62rem; letter-spacing: .12em;
    text-transform: uppercase; color: var(--hue);
  }
  :root[data-theme="light"] .kind { color: color-mix(in srgb, var(--hue) 72%, var(--text)); }
  .card h3 { font-size: var(--step-1); line-height: 1.25; }
  .card:hover h3 { color: var(--hue); }
  .card p { color: var(--muted); font-size: .93rem; line-height: 1.55; }

  .status {
    display: inline-flex; align-items: center; gap: .4rem; margin-top: .25rem;
    color: var(--faint); font-family: var(--mono); font-size: .6rem;
  }
  .status::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--hue); }

  .read { margin-top: auto; padding-top: .7rem; font-family: var(--mono); font-size: var(--step--1); color: var(--cyan); }

  @media (max-width: 700px) {
    .category-heading { align-items: start; flex-direction: column; gap: .5rem; }
  }
</style>
