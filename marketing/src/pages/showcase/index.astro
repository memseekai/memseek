---
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Hub for the interactive showcases. The showcases themselves are hand-written,
 * self-contained HTML in public/showcase/<slug>/index.html — Astro copies them
 * verbatim and never parses them, so they keep their own styling and scripts.
 * Adding one is two steps: drop the file in public/, add a row here.
 */
/**
 * One card per memory kind. `kind` is the label a reader already knows the
 * concept by — it does the work three jargon tag-pills used to do badly, and it
 * is why the list reads as coverage rather than as seven unrelated demos. One
 * sentence each: the card decides whether to open the page, nothing more.
 */
const showcases = [
  {
    href: '/membukkit/',
    slug: 'membukkit',
    kind: 'open agent-memory showcase',
    title: 'MemBukkit',
    blurb: 'Explore the library, GUI, SOTA search method, and reproducible memory benchmarks.',
    accent: 'var(--orange)',
  },
  {
    slug: 'workspace-explorer',
    kind: 'workspace surface',
    title: 'The workspace explorer',
    blurb: 'Collections, records, derivations, views, and artifacts in one calm control surface.',
    accent: 'var(--cyan)',
  },
  {
    slug: 'agent-memory',
    kind: 'layered memory',
    title: 'The agent memory reactor',
    blurb: 'Watch exact messages rise into atomic claims, maintained scenes, and durable persona.',
    accent: 'var(--green)',
  },
  {
    slug: 'generative-agents',
    kind: 'episodic',
    title: 'Generative agents',
    blurb: "Park et al.'s memory stream, importance and reflection — as one catalog.",
    accent: 'var(--violet)',
  },
  {
    slug: 'gbrain',
    kind: 'semantic · graph',
    title: 'An entire brain, declared',
    blurb: 'A knowledge base that assembles itself, every fact traceable to its page.',
    accent: 'var(--orange)',
  },
  {
    slug: 'self-audit',
    kind: 'reflection',
    title: 'The self-auditing mind',
    blurb: 'Beliefs built on beliefs, and a detector that catches its own contradictions.',
    accent: 'var(--pink)',
  },
  {
    slug: 'dreams',
    kind: 'consolidation',
    title: 'dreams × memseek',
    blurb: "Anthropic's Dreams as one bounded, cited derivation you adopt as a diff.",
    accent: 'var(--amber)',
  },
  {
    slug: 'living-profile',
    kind: 'entity profiles',
    title: 'The living profile',
    blurb: 'A CRM profile that maintains itself from raw events, every slot cited.',
    accent: 'var(--cyan)',
  },
  {
    slug: 'skill',
    kind: 'procedural',
    title: 'The maintained skill',
    blurb: 'A playbook that revises itself from real outcomes, behind a human gate.',
    accent: 'var(--green)',
  },
  {
    slug: 'mcp',
    kind: 'tool surface',
    title: 'Plug it into an existing agent',
    blurb: 'Five declared tools, compiled over stdio. Capabilities as YAML, not code.',
    accent: 'var(--violet)',
  },
];
---

<BaseLayout
  title="Showcases — Memseek"
  description="Interactive walkthroughs of the Memseek context engine: a self-wiring knowledge graph, a profile that maintains itself from raw events, and memory curation as a reviewable, cited diff."
>
  <section class="sc-hero">
    <div class="wrap">
      <span class="eyebrow">Showcases</span>
      <h1>See it <span class="grad">actually run.</span></h1>
      <p class="lede">
        One walkthrough per memory mechanism the context engine runs — episodic, semantic,
        reflection, consolidation. Each is a single page you can poke at: no signup, nothing to
        provision.
      </p>
    </div>
  </section>

  <section class="sc-list">
    <div class="wrap grid">
      {showcases.map((s) => (
        <article class="card" style={`--hue: ${s.accent}`}>
          <a href={s.href ?? `/showcase/${s.slug}/`} class="hit" aria-label={s.title}></a>
          <div class="body">
            <span class="kind">{s.kind}</span>
            <h2>{s.title}</h2>
            <p>{s.blurb}</p>
            <span class="read">Open →</span>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .sc-hero { position: relative; padding-top: clamp(2.4rem, 5vw, 4rem); padding-bottom: clamp(1.6rem, 3vw, 2.4rem); overflow: hidden; }
  .sc-hero::before {
    content: ""; position: absolute; inset: -60% -10% auto; height: 460px; z-index: 0; pointer-events: none;
    background:
      radial-gradient(38% 60% at 18% 40%, color-mix(in srgb, var(--orange) 26%, transparent), transparent 70%),
      radial-gradient(38% 56% at 62% 20%, color-mix(in srgb, var(--violet) 22%, transparent), transparent 72%);
    opacity: .85;
  }
  .sc-hero .wrap { position: relative; z-index: 1; }
  .sc-hero h1 { font-size: var(--step-3); margin-top: 1.1rem; max-width: 16ch; }
  .lede { color: var(--muted); max-width: 48ch; margin-top: 1.1rem; }

  .sc-list { padding-bottom: clamp(3rem, 7vw, 6rem); }
  /* Narrower track than the old blurb needed: one sentence per card reads better
     three-across than two, and seven cards land in three rows instead of four. */
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1rem; }

  .card {
    position: relative;
    border: 1px solid var(--border); border-radius: 14px;
    background: var(--surface); box-shadow: var(--shadow);
    overflow: hidden; display: flex; flex-direction: column;
    transition: border-color .18s, transform .18s;
  }
  .card::before { content: ""; position: absolute; inset: 0 0 auto; height: 2px; background: var(--hue); }
  .card:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  /* One stretched link keeps the whole card clickable without nesting anchors. */
  .hit { position: absolute; inset: 0; z-index: 2; }

  .body { padding: 1.3rem 1.3rem 1.15rem; display: flex; flex-direction: column; gap: .5rem; flex: 1; }
  /* The memory kind, not the URL: it is the one label that tells a reader
     whether this card is the thing they came looking for. */
  .kind {
    font-family: var(--mono); font-size: .62rem; letter-spacing: .12em;
    text-transform: uppercase; color: var(--hue);
  }
  :root[data-theme="light"] .kind { color: color-mix(in srgb, var(--hue) 72%, var(--text)); }
  .card h2 { font-size: var(--step-1); line-height: 1.25; }
  .card:hover h2 { color: var(--hue); }
  .card p { color: var(--muted); font-size: .93rem; line-height: 1.55; }

  .read { margin-top: auto; padding-top: .7rem; font-family: var(--mono); font-size: var(--step--1); color: var(--cyan); }
</style>
