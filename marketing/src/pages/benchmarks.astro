---
import BaseLayout from '../layouts/BaseLayout.astro';
import Atmosphere from '../components/Atmosphere.astro';
import BenchLab from '../components/BenchLab.astro';
import { BENCHMARK_GUIDE_URL, MEMBUKKIT_REPO_URL } from '../lib/links';
import '../styles/bench.css';

const howItWorks = [
  ['01', 'Group related memory.', 'Topic buckets create useful regions to search as the history grows.'],
  ['02', 'Spend the scan budget wisely.', 'Route the question to promising buckets, then rank the evidence inside them.'],
  ['03', 'Follow the receipts.', 'Review source references, buckets opened, and the budget used for the result.'],
];
---

<BaseLayout
  title="Memory benchmarks — Memseek"
  description="92.6% on LongMemEval-S: 463 of 500 answers judged correct by the official GPT-4o judge. The published configuration, all eleven comparison series, and how to reproduce the result."
>
  <div class="finish-membukkit">
    <div class="wrap">
      <section class="benchmark-head" data-atmosphere="hero">
        <Atmosphere scene="hero" />
        <div>
          <h1>The memory behind Memseek,<br />put to the test.</h1>
          <p>
            Memseek uses an open-source memory engine called <strong>MemBukkit</strong>. These
            benchmarks test that engine on questions about long conversation histories.
          </p>
        </div>
        <div>
          <div class="actions">
            <a class="btn" href="/start/">Try Memseek <span class="arrow" aria-hidden="true">↗</span></a>
            <a class="textlink" href={BENCHMARK_GUIDE_URL} target="_blank" rel="noopener noreferrer">
              Reproduce the result <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </div>
          <span class="small">Open code · Published methods</span>
        </div>
      </section>

      <BenchLab />
    </div>

    <section class="section wrap">
      <div class="split">
        <div>
          <h2>The facts change.<br />The evidence stays.</h2>
          <p>
            MemBukkit retains dated facts, earlier states and the sources behind them. An agent can
            work from the current knowledge and still explain how it changed.
          </p>
          <p>Ask about a date. Retrieve the evidence that applied then.</p>
          <a class="textlink" href="/#company-learning">
            See the learning loop <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="timeline">
          <div class="time-record">
            <div class="meta"><span>Previous state</span><span class="tag old">History</span></div>
            <p>Earlier facts, their dates and their original sources.</p>
          </div>
          <div class="time-record">
            <div class="meta"><span>Current state</span><span class="tag">Latest evidence</span></div>
            <p>Updated facts, with a record of what changed.</p>
          </div>
          <div class="inline-note">A current answer does not erase the past.</div>
        </div>
      </div>
    </section>

    <section class="section tint">
      <div class="wrap">
        <div class="section-head">
          <h2>How the memory works.</h2>
          <p>MemBukkit groups related information into topic buckets, then searches for the evidence a question needs.</p>
        </div>
        <div class="grid3">
          {howItWorks.map(([n, title, body]) => (
            <article class="problem">
              <div class="number">{n}</div>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section wrap">
      <div class="split">
        <div>
          <h2>Only need the memory engine?</h2>
          <p>
            Developers can also use MemBukkit independently in an existing agent. Use the Python
            library or CLI, try the local demo and inspect the memory it retrieves.
          </p>
          <p class="small">
            The demo needs a configured model and may incur model costs. Initial setup downloads
            dependencies and model weights.
          </p>
          <a class="textlink" href={MEMBUKKIT_REPO_URL} target="_blank" rel="noopener noreferrer">
            Open MemBukkit on GitHub <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
        <div>
          <pre class="api" id="install-code">git clone {MEMBUKKIT_REPO_URL}
cd membukkit
pip install -e ".[all]"

<span class="comment"># Configure your model credentials first.
# Open the bundled memory demo:</span>
membukkit ui --demo personal-assistant</pre>
          <p class="caption">Use the repository documentation for model configuration.</p>
        </div>
      </div>
    </section>

    <section class="section spotlight">
      <div class="wrap split">
        <div>
          <h2>Build with Memseek.</h2>
          <p>
            Give your existing agents knowledge that stays current. Run Memseek yourself, or work
            with us on the source connections, updates and delivery for your workflow.
          </p>
          <a class="btn light" href="/start/">Try Memseek <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
        <div class="memory-diagram">
          <div class="diagram-head">Memseek</div>
          <p>The self-learning context engine</p>
          <div class="memory-core">
            <strong>Remember → understand → act</strong>
            <p>One place to keep your agents’ knowledge current.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import '../scripts/bench-lab';
</script>

<style>
  .benchmark-head {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 60px;
    align-items: end;
    padding: 64px 0 48px;
  }
  .benchmark-head h1 { max-width: 780px; font-size: clamp(40px, 4.7vw, 61px); line-height: 1.08; }
  .benchmark-head > div:first-child > p { max-width: 560px; margin: 22px 0 0; font-size: 18px; line-height: 1.6; }
  .benchmark-head .small { display: block; margin-top: 16px; font-size: 13px; color: var(--muted); }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  .split h2 { margin-bottom: 24px; }
  .split p { max-width: 520px; margin-bottom: var(--s-4); }
  .split p.small { font-size: 13px; color: var(--muted); }

  .section-head { max-width: 640px; margin-bottom: 32px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 35px; }
  .problem .number { font-size: 14px; line-height: 1.5; color: #4e638b; }
  .problem h3 { margin: 18px 0 10px; font-size: 27px; line-height: 1.2; letter-spacing: -.035em; }
  .problem p { margin: 0; font-size: 16px; line-height: 1.6; }

  .timeline { display: grid; gap: 14px; }
  .time-record { padding: 20px 22px; border: 1px solid var(--line); border-radius: var(--r); background: var(--paper); }
  .time-record .meta { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 10px; font-size: 12px; color: var(--muted); }
  .time-record p { margin: 0; font-size: 15px; }
  .tag { padding: 3px 8px; border-radius: var(--r-xs); background: var(--blue-soft); color: var(--deep); font-size: 11px; }
  /* A superseded state is still a state. Grey marks it retained, not deleted. */
  .tag.old { background: var(--silver); color: var(--muted); }
  .inline-note {
    padding: 16px 20px;
    border-left: 3px solid #91a7c3;
    background: var(--silver);
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  .api {
    margin: 0;
    padding: 29px;
    border: 1px solid #cbd8f7;
    border-radius: 20px;
    background: linear-gradient(145deg, #eef3ff, #fff 70%);
    box-shadow: inset 0 1px 0 #fff, 0 20px 46px -28px #375cc457;
    color: #35486c;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.85;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .api .comment { color: #596e9b; }
  .caption { margin: 12px 0 0; font-size: 12px; color: var(--muted); }

  /* Named for what it does, not what it used to be: this band is a light
     lilac wash with one saturated card inside it. */
  .section.spotlight { background: linear-gradient(125deg, #e6efff, #eee9ff); color: var(--ink); }

  .memory-diagram {
    padding: 30px;
    border: 1px solid #d5def2;
    border-radius: 20px;
    background: linear-gradient(135deg, #ffffffed, #f7f9ffcf);
    box-shadow: inset 0 1px 0 #fff, 0 2px 4px #29469306, 0 20px 46px -28px #375cc457;
    color: #375b79;
  }
  .diagram-head { margin-bottom: 10px; font-size: 24px; font-weight: 550; letter-spacing: -.035em; color: var(--ink); }
  .memory-diagram > p { margin: 0 0 24px; font-size: 14px; }
  .memory-core {
    padding: 24px;
    border: 1px solid #9db4ff;
    border-radius: 14px;
    background: linear-gradient(130deg, #4b75ee, #5e43d8);
    box-shadow: inset 0 1px 0 #ffffff70, 0 12px 23px -15px #294cd18c;
    color: #fff;
  }
  .memory-core strong { display: block; margin-bottom: 10px; font-size: 18px; font-weight: 550; color: #fff; }
  .memory-core p { margin: 0; font-size: 14px; color: #e5eaff; }

  @media (max-width: 1000px) {
    .benchmark-head { grid-template-columns: 1fr; gap: 28px; }
    .split { gap: 40px; }
    .grid3 { grid-template-columns: 1fr; gap: 26px; }
  }
  @media (max-width: 760px) {
    .benchmark-head { padding: 42px 0 32px; }
    .benchmark-head h1 { font-size: 40px; }
    .split { grid-template-columns: 1fr; gap: 35px; }
    .api { padding: 20px; font-size: 12px; border-radius: 16px; }
    .memory-diagram { padding: 24px; }
    .problem h3 { font-size: 25px; }
  }
</style>
