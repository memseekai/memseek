---
/**
 * The canonical benchmark page: every number any other surface quotes lives
 * here, with its grader and its cost basis next to it. The landing page's
 * #benchmarks section is a two-panel summary of this table — if a score
 * changes, change it in both places (public/index.html holds the other copy).
 */
import BaseLayout from '../layouts/BaseLayout.astro';

/** LongMemEval-S, 500 questions. One row per system at its best published score.
 *  grader: 'official' = the benchmark's own judge · 'self' = the vendor's own AI
 *  cost:   null where the vendor publishes no per-answer figure. */
const rows = [
  { sys: 'Mem0 Cloud',        model: 'GPT-5',        acc: 94.4, grader: 'self',     cost: null,     us: false },
  { sys: 'Memseek',           model: 'gpt-5.4',      acc: 92.6, grader: 'official', cost: '$0.015', us: true },
  { sys: 'Hindsight',         model: 'Gemini-3 Pro', acc: 91.4, grader: 'self',     cost: null,     us: false },
  { sys: 'Zep',               model: 'gpt-5.4',      acc: 90.2, grader: 'self',     cost: null,     us: false },
  { sys: 'Gemini 2.5 Pro alone', model: 'no memory system, re-reads 122.9k tokens per question', acc: 89.2, grader: 'independent', cost: '$0.16', us: false },
  { sys: 'Memseek',           model: 'Gemma 26B (open weights)', acc: 88.8, grader: 'official', cost: '$0.0004', us: true },
  { sys: 'Supermemory',       model: 'Gemini-3 Pro', acc: 85.2, grader: 'official', cost: null,     us: false, note: 1 },
  { sys: 'Memseek',           model: 'gpt-4o-mini',  acc: 82.0, grader: 'official', cost: '$0.0005', us: true },
  { sys: 'Zep',               model: 'GPT-4o',       acc: 71.2, grader: 'official', cost: null,     us: false },
  { sys: 'whole history into GPT-4o', model: 'no memory system', acc: 60.2, grader: 'official', cost: '$0.29', us: false },
];

const graderLabel = {
  official: "benchmark's official judge",
  self: 'the vendor’s own AI',
  independent: 'independent academic measurement',
};
---

<BaseLayout
  title="Benchmarks — Memseek"
  description="92.6% on LongMemEval-S under the benchmark's official judge, with every score, grader and cost per answer in one table."
>
  <section class="head">
    <div class="wrap">
      <span class="eyebrow" style="--hue:var(--green)">public benchmarks · official grader</span>
      <h1><span class="big">92.6%</span> on LongMemEval-S.<br>Graded by the benchmark, not by us.</h1>
      <p class="lede">Most published memory scores are produced by asking a model to mark its own
        answers. This page keeps that distinction in every row: <b>who ran it, which model, who
        graded it, and what one answer cost</b>. Under the official judge, Memseek is the highest
        score on the board — and the open-weight configuration is within four points of it at
        roughly a fortieth of the price.</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#results">The whole table ↓</a>
        <a class="btn btn-ghost" href="#methodology">Methodology</a>
        <span class="console-chip"><span class="p">$</span> memseek bench longmemeval --official-judge</span>
      </div>
      <p class="prov">LongMemEval-S · 500 questions · answer accuracy · page last updated 31 July 2026</p>
    </div>
  </section>

  <!-- ============ THE TABLE ============
       Deliberately first, and deliberately plain: the charts below are two
       readings of exactly these rows and nothing else. -->
  <section id="results" class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">every score, one table</span>
        <h2>Answer accuracy on LongMemEval-S.</h2>
        <p>Each system at its <b>best published configuration</b>. Rows marked
          <i class="selfg-k">self-graded</i> were scored by the vendor's own model rather than by
          the benchmark's judge, which is not the same measurement and is not comparable to one.</p>
      </div>

      <div class="rt-scroll">
        <table class="rt">
          <thead>
            <tr>
              <th>System</th>
              <th>Model</th>
              <th class="num">Accuracy</th>
              <th>Graded by</th>
              <th class="num">Cost / answer</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class={[r.us ? 'us' : '', r.grader === 'self' ? 'selfg' : ''].join(' ').trim()}>
                <th scope="row">{r.sys}{r.note === 1 && <sup>1</sup>}</th>
                <td class="model">{r.model}</td>
                <td class="num score">{r.acc.toFixed(1)}%</td>
                <td class="grader">{graderLabel[r.grader]}</td>
                <td class="num cost">{r.cost ?? <span class="none">not published</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ol class="fnotes">
        <li>Supermemory markets a “95%” figure computed on a different metric; the number here is
          answer accuracy under the official judge, the same measurement as every other row.</li>
      </ol>
    </div>
  </section>

  <!-- ============ COST ============ -->
  <section id="cost">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow" style="--hue:var(--cyan)">the axis nobody plots</span>
        <h2>Accuracy against what an answer costs.</h2>
        <p>A memory system earns its place by being <b>both</b> more accurate and cheaper than
          shoving the transcript back through a frontier model. Three decades of cost, log scale.</p>
      </div>

      <div class="panel">
        <div class="scatter-scroll">
          <div
            class="scatter"
            role="img"
            aria-label="Accuracy against cost per answer on LongMemEval-S. Memseek reaches 92.6% at $0.015 per answer with gpt-5.4, 88.8% at $0.0004 on open-weight Gemma 26B, and 82.0% at $0.0005 on gpt-4o-mini. Reading the whole history into GPT-4o scores 60.2% at $0.29 per answer; Gemini 2.5 Pro re-reading 123k tokens scores 89.2% at $0.16."
          >
            <div class="gridline-y" style="bottom:11.1%"><span class="tag">60%</span></div>
            <div class="gridline-y" style="bottom:33.3%"><span class="tag">70%</span></div>
            <div class="gridline-y" style="bottom:55.6%"><span class="tag">80%</span></div>
            <div class="gridline-y" style="bottom:77.8%"><span class="tag">90%</span></div>
            <div class="gridline-y" style="bottom:100%"><span class="tag">100%</span></div>
            <div class="gridline-x" style="left:21.7%"><span class="tag2">$1k / 1M answers</span><span class="tag">$0.001</span></div>
            <div class="gridline-x" style="left:50.7%"><span class="tag2">$10k / 1M</span><span class="tag">$0.01</span></div>
            <div class="gridline-x" style="left:79.7%"><span class="tag2">$100k / 1M</span><span class="tag">$0.10</span></div>

            <div class="pt us" style="left:8.5%; bottom:75.1%"></div>
            <div class="ptlab us" style="left:5%; bottom:83%">Memseek + Gemma 26B (open weights)<br><span class="score">88.8%</span> · $0.0004</div>

            <div class="pt us" style="left:13.6%; bottom:60%"></div>
            <div class="ptlab us" style="left:10%; bottom:47%">Memseek + gpt-4o-mini<br><span class="score">82.0%</span> · $0.0005</div>

            <div class="pt us" style="left:55.7%; bottom:83.6%"></div>
            <div class="ptlab us" style="left:59%; bottom:84.5%">Memseek + gpt-5.4<br><span class="score">92.6%</span> · $0.015</div>

            <div class="pt other" style="left:42%; bottom:67.1%"></div>
            <div class="ptlab" style="left:29%; bottom:55.5%">Supermemory + Gemini-3 Pro<br><span class="score">85.2%</span></div>

            <div class="pt other" style="left:46.2%; bottom:36%"></div>
            <div class="ptlab" style="left:41%; bottom:26%">Zep + GPT-4o<br><span class="score">71.2%</span></div>

            <div class="pt other" style="left:93.1%; bottom:11.6%"></div>
            <div class="ptlab r" style="right:.5%; bottom:16%">whole history into GPT-4o<br><span class="score">60.2%</span> · $0.29</div>

            <div class="pt other" style="left:85.4%; bottom:76%"></div>
            <div class="ptlab r" style="right:.5%; bottom:58%">Gemini 2.5 Pro alone,<br>re-reads all 123k tokens<br><span class="score">89.2%</span> · $0.16</div>

            <div class="pt selfg" style="left:52.6%; bottom:87.6%"></div>
            <div class="ptlab selfg" style="left:30%; bottom:92%">Mem0 Cloud + GPT-5<br>(self-graded) <span class="score">94.4%</span></div>

            <div class="pt selfg" style="left:56.2%; bottom:78.2%"></div>
            <div class="ptlab selfg" style="left:36%; bottom:76.5%">Zep + gpt-5.4<br>(self-graded) <span class="score">90.2%</span></div>

            <div class="pt selfg" style="left:60.1%; bottom:80.9%"></div>
            <div class="ptlab selfg" style="left:63.5%; bottom:72%">Hindsight + Gemini-3 Pro<br>(self-graded) <span class="score">91.4%</span></div>
          </div>
        </div>

        <div class="legend">
          <span><span class="sw" style="background:var(--green)"></span>Memseek, official grading</span>
          <span><span class="sw" style="background:var(--border-strong)"></span>others, official grading</span>
          <span><span class="sw" style="background:transparent;border:2px dashed var(--rose)"></span>graded their own answers</span>
        </div>

        <p class="bench-foot">Cost = model list prices on measured context; frontier models bill
          hidden reasoning tokens above that floor, so treat every point as a lower bound. Points
          without a cost in the table are positioned from list prices on their published
          configuration. Gemini 2.5 Pro full-context: independent academic measurement
          (arXiv:2601.14287), 122.9k tokens re-read per question.</p>
      </div>
    </div>
  </section>

  <!-- ============ BEYOND LONGMEMEVAL ============ -->
  <section id="more" class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow" style="--hue:var(--violet)">the other datasets</span>
        <h2>Multi-hop QA, updated facts, and context size.</h2>
        <p>LongMemEval is one question shape. These are the three others that decide whether a
          context engine is doing anything a vector index wasn't already doing.</p>
      </div>

      <div class="grid3">
        <div class="stat">
          <div class="n">+7.5<small> pts</small></div>
          <div class="metric">exact match vs. standard dense retrieval</div>
          <div class="src">MuSiQue · multi-hop QA</div>
        </div>
        <div class="stat">
          <div class="n">+10.8<small> pts</small></div>
          <div class="metric">exact match vs. standard dense retrieval</div>
          <div class="src">2WikiMultiHopQA · multi-hop QA</div>
        </div>
        <div class="stat">
          <div class="n">91%</div>
          <div class="metric">picks the latest valid fact</div>
          <div class="src">LongMemEval-S · knowledge-update questions</div>
        </div>
      </div>

      <div class="panel tokens">
        <div class="th">
          <h3>Context assembled per question</h3>
          <span class="mult">≈ 32× fewer tokens</span>
        </div>
        <div class="trow">
          <span class="lab">Full history<span class="sub">every message, re-read</span></span>
          <div class="tbar full"><i style="--w:100"></i><span class="v">~101,000</span></div>
        </div>
        <div class="trow us">
          <span class="lab">Memseek<span class="sub">assembled, cited, budgeted</span></span>
          <div class="tbar mem"><i style="--w:3.2"></i><span class="v" style="--w:3.2">~3,200</span></div>
        </div>
        <p class="bench-foot">This is the number that compounds: it is paid on every call your
          agent makes, for the life of the product, and it is why the cheap configurations above are
          cheap. Each assembled context ships with a hashed manifest of what went into it.</p>
      </div>
    </div>
  </section>

  <!-- ============ METHODOLOGY ============ -->
  <section id="methodology">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow" style="--hue:var(--amber)">methodology</span>
        <h2>What was measured, and what wasn't.</h2>
      </div>

      <div class="mgrid">
        <div class="m">
          <h3>The dataset</h3>
          <p><b>LongMemEval-S</b>, 500 questions over long multi-session chat histories. It tests the
            three things agents actually get wrong: finding one fact in a long history, tracking a
            fact that changed, and joining evidence that never appeared in the same session.</p>
        </div>
        <div class="m">
          <h3>The grader</h3>
          <p>The benchmark's <b>own judge</b>, unmodified, on every Memseek row. Where a vendor
            published only a score their own model produced, the row says so — a self-graded number
            and an officially graded number are different measurements, and averaging them or
            ranking across them is meaningless.</p>
        </div>
        <div class="m">
          <h3>The system under test</h3>
          <p>The shipped catalog on <b>PostgreSQL 16 + pgvector</b>, retrieval over
            <code>text-embedding-3-small</code>, with declared per-derivation ceilings
            (<code>max_llm_calls</code>, <code>max_total_tokens</code>, <code>max_wall_s</code>).
            The three Memseek rows differ only in which model the aliases point at —
            <code>gpt-5.4</code>, open-weight <b>Gemma 26B</b>, or <code>gpt-4o-mini</code>. No
            per-dataset tuning, no benchmark-only definitions.</p>
        </div>
        <div class="m">
          <h3>The cost basis</h3>
          <p>Provider <b>list prices</b> applied to measured context: tokens assembled into the
            prompt plus tokens generated, per answered question. Frontier models bill reasoning
            tokens you cannot see, so every figure is a floor rather than an invoice. Postgres,
            embeddings and storage are excluded — they do not vary between the rows.</p>
        </div>
        <div class="m">
          <h3>What this does not show</h3>
          <p>A public benchmark is a <b>lower bound on a proxy</b>. It says nothing about your
            domain, your write volume, or your latency budget, and nothing about the properties
            that made us build this — supersession, citation enforcement, point-in-time replay,
            recursive erase. Those are correctness guarantees, not scores.</p>
        </div>
        <div class="m">
          <h3>Reproduce it</h3>
          <p>One command against the same API you would call in production, with the answers handed
            to the benchmark's judge rather than to a model of ours:</p>
          <pre><code><span class="p">$</span> make quickstart
<span class="p">$</span> memseek bench longmemeval --official-judge</code></pre>
          <p>Every derivation in the run leaves an <b>audited run record</b> — trigger, model,
            inputs, outputs, tokens — so the score is reconstructible from your own database rather
            than from our screenshot.</p>
        </div>
      </div>

      <p class="sec-foot">Numbers here are the ones quoted everywhere else on this site. If you find
        a disagreement between this page and any other page, this page is correct and the other one
        is a bug — <a href="https://github.com/memseekai/memseek">open an issue</a>.</p>
    </div>
  </section>

  <section class="alt closer">
    <div class="wrap">
      <h2>Run it against your own history.</h2>
      <p>The interesting number is not ours — it is what your agent stops getting wrong.
        <code>make quickstart</code> gets you a local instance with Postgres, the schema and a
        workspace key; <code>LLM_FAKE=1</code> runs the whole loop before you spend a token.</p>
      <div class="ctas">
        <a class="btn btn-primary" href="/#waitlist">Join the waitlist →</a>
        <a class="btn btn-ghost" href="https://github.com/memseekai/memseek">Start from the source</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Chart chrome is mirrored from public/index.html's #benchmarks section —
     same tokens, same geometry, so the summary and this page read as one
     artifact. Positions:
       bar:   --w = value on its own scale (score / 1.076, or % of full history)
       point: bottom% = (accuracy - 55) / 45 * 100
              left%   = (log10(cost) + 3.75) / 3.45 * 100   — three decades */
  section { padding-block: clamp(3rem, 6vw, 5.2rem); }
  .alt { background: var(--surface); border-block: 1px solid var(--border); }
  h1 { font-size: var(--step-3); margin-top: .8rem; }
  h1 .big { color: var(--orange); font-variant-numeric: tabular-nums; }
  .head .lede { color: var(--muted); font-size: var(--step-1); line-height: 1.55; max-width: 68ch; margin-top: 1.1rem; }
  .head .lede b { color: var(--text); font-weight: 600; }
  .prov { margin-top: 1.4rem; font-family: var(--mono); font-size: .72rem; color: var(--faint); }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; margin-top: 1.6rem; }
  .console-chip { font-family: var(--mono); font-size: .74rem; color: var(--faint); background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: .6rem .9rem; }
  .alt .console-chip { background: var(--bg); }
  .console-chip .p { color: var(--orange); }

  .sec-head { max-width: 64ch; margin-bottom: clamp(1.8rem, 3.5vw, 2.6rem); }
  .sec-head h2 { font-size: var(--step-2); margin-top: .8rem; }
  .sec-head p { color: var(--muted); font-size: var(--step-1); margin-top: .9rem; line-height: 1.5; text-wrap: pretty; }
  .sec-head p b { color: var(--text); font-weight: 600; }
  .sec-foot { margin-top: 1.6rem; font-size: var(--step--1); color: var(--muted); line-height: 1.55; max-width: 72ch; }
  .selfg-k { font-style: italic; color: color-mix(in srgb, var(--rose) 80%, var(--muted)); }

  /* ---------- results table ---------- */
  .rt-scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: 13px; background: var(--bg); }
  .rt { width: 100%; border-collapse: collapse; font-size: var(--step--1); min-width: 640px; }
  .rt th, .rt td { text-align: left; padding: .85rem 1.1rem; border-bottom: 1px solid var(--border); }
  .rt thead th { font-family: var(--mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--faint); font-weight: 500; }
  .rt tbody tr:last-child th, .rt tbody tr:last-child td { border-bottom: 0; }
  .rt tbody th { font-weight: 600; color: var(--text); font-size: var(--step--1); }
  .rt .num { text-align: right; font-family: var(--mono); font-variant-numeric: tabular-nums; }
  .rt .model, .rt .grader { color: var(--muted); }
  .rt .model { font-family: var(--mono); font-size: .72rem; }
  .rt .score { color: var(--text); font-weight: 700; }
  .rt .cost { color: var(--muted); }
  .rt .none { font-family: var(--sans); font-size: .72rem; color: var(--faint); }
  /* our rows carry the accent; self-graded rows carry the caveat */
  .rt tr.us { background: color-mix(in srgb, var(--green) 7%, transparent); }
  .rt tr.us th { box-shadow: inset 3px 0 0 var(--green); }
  .rt tr.us .score { color: var(--green); }
  .rt tr.selfg th, .rt tr.selfg .grader { font-style: italic; color: color-mix(in srgb, var(--rose) 78%, var(--muted)); }
  .rt sup { color: var(--faint); font-size: .7em; }
  .fnotes { margin: 1.1rem 0 0 1.2rem; color: var(--faint); font-size: .74rem; line-height: 1.55; max-width: 80ch; }

  /* ---------- panels shared with the landing page ---------- */
  .panel { border: 1px solid var(--border); border-radius: 13px; background: var(--surface); padding: 1.5rem 1.6rem; }
  .alt .panel { background: var(--bg); }
  .panel .th { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem; margin-bottom: 1.4rem; }
  .panel .th h3 { font-size: var(--step-1); }
  .panel .th .mult { font-family: var(--mono); color: var(--green); font-weight: 700; font-size: var(--step--1); }
  .bench-foot { margin-top: 1.05rem; padding-top: .85rem; border-top: 1px solid var(--border); color: var(--faint); font-size: .72rem; font-family: var(--mono); line-height: 1.55; }

  .tokens { margin-top: 1.2rem; }
  .trow { display: grid; grid-template-columns: 11.5rem 1fr; gap: .85rem; align-items: center; margin-bottom: 1rem; }
  @media (max-width: 560px) { .trow { grid-template-columns: 1fr; gap: .25rem; } }
  .trow .lab { font-family: var(--mono); font-size: .72rem; color: var(--muted); line-height: 1.35; }
  .trow.us .lab { color: var(--text); font-weight: 700; }
  .trow .lab .sub { display: block; font-size: .62rem; font-weight: 400; color: var(--faint); }
  .tbar { height: 22px; border-radius: 5px; background: var(--surface-2); overflow: hidden; position: relative; }
  .tbar > i { position: absolute; inset: 0; border-radius: 5px; clip-path: inset(0 calc(100% - var(--w) * 1%) 0 0 round 5px); }
  .tbar.mem > i { background: linear-gradient(90deg, var(--green), var(--cyan)); }
  .tbar.full > i { background: linear-gradient(90deg, color-mix(in srgb, var(--rose) 45%, var(--surface-2)), var(--rose)); }
  .tbar .v { position: absolute; right: .5rem; top: 50%; transform: translateY(-50%); font-family: var(--mono); font-size: .68rem; color: var(--muted); }
  /* 3.2% of the track is too narrow to sit a label inside, so this one rides
     just outside the fill rather than on it */
  .tbar.mem .v { left: calc(var(--w) * 1% + .55rem); right: auto; color: var(--green); font-weight: 700; }

  /* ---------- accuracy vs. cost ---------- */
  .scatter-scroll { overflow: visible; }
  .scatter { position: relative; height: 500px; margin: 1.9rem 1rem 2.6rem 3rem; }
  @media (max-width: 700px) {
    .scatter-scroll { overflow-x: auto; overflow-y: hidden; }
    .scatter { min-width: 560px; height: 420px; }
  }
  .gridline-y { position: absolute; left: 0; right: 0; height: 1px; background: var(--border); }
  .gridline-y .tag { position: absolute; left: -2.5rem; top: -.5em; font-family: var(--mono); font-size: .66rem; color: var(--faint); }
  .gridline-x { position: absolute; top: 0; bottom: -1.6rem; width: 1px; background: var(--border); }
  .gridline-x .tag { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); font-family: var(--mono); font-size: .66rem; color: var(--faint); white-space: nowrap; }
  .gridline-x .tag2 { position: absolute; top: -1.5rem; left: 50%; transform: translateX(-50%); font-family: var(--mono); font-size: .62rem; color: var(--faint); opacity: .75; white-space: nowrap; }
  .pt { position: absolute; width: 13px; height: 13px; border-radius: 50%; transform: translate(-50%, 50%); }
  .pt.us { width: 16px; height: 16px; background: var(--green); box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 25%, transparent); }
  .pt.other { background: var(--border-strong); }
  .pt.selfg { background: transparent; border: 2px dashed var(--rose); }
  .ptlab { position: absolute; font-family: var(--mono); font-size: .68rem; line-height: 1.35; color: var(--muted); white-space: nowrap; }
  .ptlab.r { text-align: right; }
  .ptlab .score { color: var(--text); font-weight: 700; }
  .ptlab.us { color: var(--green); }
  .ptlab.us .score { color: var(--green); font-size: .84rem; }
  .ptlab.selfg { color: color-mix(in srgb, var(--rose) 80%, var(--muted)); font-style: italic; }
