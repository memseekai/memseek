---
import BaseLayout from '../layouts/BaseLayout.astro';
import { longMemEvalFieldRows as comparisonRows, pairedFindings } from '../lib/benchmark-data';

const repo = 'https://github.com/memseekai/membukkit';
const docs = `${repo}/tree/main/docs`;
const benchmarks = `${repo}/blob/main/docs/guide/benchmarks.md`;
const judges = `${benchmarks}#who-judges-what`;

const capabilities = [
  {
    n: '01',
    title: 'Dated facts',
    body: 'Turn conversations and documents into atomic facts with dates and source references.',
    hue: 'var(--orange)',
  },
  {
    n: '02',
    title: 'As-of answers',
    body: 'Ask what was true on a particular date instead of flattening old and new facts together.',
    hue: 'var(--cyan)',
  },
  {
    n: '03',
    title: 'Supersession',
    body: 'Mark what changed without silently deleting the history needed to explain the answer.',
    hue: 'var(--violet)',
  },
  {
    n: '04',
    title: 'Receipts',
    body: 'See the scan budget, buckets opened, evidence used, and source turn behind a result.',
    hue: 'var(--green)',
  },
];

---

<BaseLayout
  title="MemBukkit — the open agent-memory showcase from Memseek"
  description="MemBukkit is Memseek's open agent-memory showcase: a library, CLI, explainability GUI, and reproducible benchmark harness for dated facts, supersession, budgeted search, and answers with receipts."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow" style="--hue:var(--green)">open agent-memory showcase · by Memseek</span>
        <div class="name"><span class="bucket-mark" aria-hidden="true">MB</span><h1>MemBukkit</h1></div>
        <p class="tagline">Open long-term memory you can trust.</p>
        <p class="lede">
          A small, inspectable library + CLI + GUI for <b>dated facts, as-of answers,
          supersession, budgeted search, and clickable receipts.</b> It is where we demonstrate the
          agent-memory method and publish the recipes behind our SOTA results.
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href={repo}>Open MemBukkit on GitHub →</a>
          <a class="btn btn-ghost" href="#quickstart">Run a demo</a>
        </div>
        <p class="license">Apache-2.0 · Python 3.10+ · runs locally</p>
      </div>

      <div class="memory-card" aria-label="A memory answer with current and superseded evidence">
        <div class="memory-top"><span>personal-assistant / ask</span><i>trace on</i></div>
        <p class="question">How much is my rent?</p>
        <div class="answer">
          <span class="answer-label">answer · as of 2024-06-01</span>
          <b>€950 per month.</b>
        </div>
        <div class="evidence current">
          <span>current</span>
          <p>Landlord raised rent to €950 from June.</p>
          <code>2024-04-02 · turn 18</code>
        </div>
        <div class="evidence old">
          <span>superseded</span>
          <p>Monthly rent is €800.</p>
          <code>2024-01-08 · turn 4</code>
        </div>
        <div class="receipt"><span>3 buckets opened</span><span>30% scan budget</span><span>2 citations</span></div>
      </div>
    </div>
  </section>

  <section class="identity-section">
    <div class="wrap">
      <div class="identity-head">
        <span class="eyebrow">how they fit together</span>
        <h2>MemBukkit demonstrates the memory. Memseek delivers the context engine.</h2>
      </div>
      <div class="identity-grid">
        <article class="identity-card product">
          <span class="kind">context engine</span>
          <h3>Memseek</h3>
          <p>
            The broader context engine for production agents: search, maintained state,
            provenance, policies, connectors, and prompt-time context assembly.
          </p>
          <a href="/context-engine/">What a context engine is →</a>
        </article>
        <div class="shared">
          <span>shared method</span>
          <b>SOTA search</b>
          <small>available in Memseek<br />demonstrated in MemBukkit</small>
        </div>
        <article class="identity-card showcase">
          <span class="kind">open showcase</span>
          <h3>MemBukkit</h3>
          <p>
            The focused agent-memory project: a library, CLI, explainability GUI, demos, and the
            public benchmark harness you can run yourself.
          </p>
          <a href={docs}>Read the MemBukkit docs →</a>
        </article>
      </div>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow" style="--hue:var(--cyan)">what the showcase proves</span>
        <h2>Memory should explain itself.</h2>
        <p>
          A vector match is not enough when facts change. MemBukkit keeps both the current answer
          and the history required to verify it.
        </p>
      </div>

      <div class="cap-grid">
        {capabilities.map((item) => (
          <article class="cap" style={`--hue:${item.hue}`}>
            <span>{item.n}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>

      <div class="method-strip">
        <div>
          <span class="mini-label">search path</span>
          <h3>Topic buckets → scan budget → hybrid ranking → evidence</h3>
        </div>
        <p>
          The method partitions memory, routes each question into the most useful region, and
          ranks within that bounded scan. MemBukkit makes each step inspectable; Memseek offers
          this search inside the full context engine.
        </p>
        <a href="/benchmarks/#search">See the method and eval →</a>
      </div>
    </div>
  </section>

  <section id="benchmarks" class="bench-section">
    <div class="wrap">
      <div class="bench-head">
        <span class="eyebrow" style="--hue:var(--green)">public benchmark · official judge</span>
        <h2><span>92.6%</span> on LongMemEval-S.<br />Highest score under the official judge.</h2>
        <p>
          Higher reported numbers use a different judge. MemBukkit uses LongMemEval’s official
          gpt-4o judge and publishes the frozen recipe behind the result.
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href={benchmarks}>Reproduce the result ↗</a>
          <a class="btn btn-ghost" href="/benchmarks/">Full methodology →</a>
        </div>
      </div>

      <div class="comparison-grid">
        <div class="benchmark-panel">
          <div class="panel-title">
            <h3>Answer accuracy</h3>
            <span>published best claims</span>
          </div>
          {comparisonRows.map((row) => (
            <div class={`benchmark-row ${row.tone}`}>
              <span class="row-label">{row.name}<small>{row.detail}</small></span>
              <div class={`score-bar ${row.tone}`} style={`--w:${row.width}`}>
                <i></i>
                <b>{row.score}</b>
              </div>
            </div>
          ))}
          <p class="bench-note">
            LongMemEval-S · 500 questions. Solid bars use the benchmark’s official gpt-4o judge.
            Patterned bars use another judge and are context, not like-for-like rankings.
            <a href={judges}>See who judged what ↗</a>
          </p>
        </div>

        <div class="benchmark-panel">
          <div class="panel-title">
            <h3>Accuracy vs. cost per answer</h3>
            <span>better and cheaper ↖</span>
          </div>
          <div class="scatter-scroll">
            <div class="scatter" role="img" aria-label="Accuracy against estimated query-time cost per answer on LongMemEval-S. MemBukkit reaches 92.6% at a $0.015 floor with gpt-5.4, 88.8% at $0.0004 with open-weight Gemma 4 26B, and 82.0% at $0.0005 with gpt-4o-mini. Full-context GPT-4o scores 60.2% at $0.29 per answer.">
              <div class="gridline-y" style="bottom:11.1%"><span>60%</span></div>
              <div class="gridline-y" style="bottom:33.3%"><span>70%</span></div>
              <div class="gridline-y" style="bottom:55.6%"><span>80%</span></div>
              <div class="gridline-y" style="bottom:77.8%"><span>90%</span></div>
              <div class="gridline-y" style="bottom:100%"><span>100%</span></div>
              <div class="gridline-x" style="left:21.7%"><small>$1k / 1M answers</small><span>$0.001</span></div>
              <div class="gridline-x" style="left:50.7%"><small>$10k / 1M</small><span>$0.01</span></div>
              <div class="gridline-x" style="left:79.7%"><small>$100k / 1M</small><span>$0.10</span></div>

              <i class="point us" style="left:8.5%; bottom:75.1%"></i>
              <span class="point-label us" style="left:5%; bottom:83%">MemBukkit + Gemma 4 26B<br /><b>88.8%</b> · $0.0004</span>

              <i class="point us" style="left:13.6%; bottom:60%"></i>
              <span class="point-label us" style="left:10%; bottom:47%">MemBukkit + gpt-4o-mini<br /><b>82.0%</b> · $0.0005</span>

              <i class="point us" style="left:55.7%; bottom:83.6%"></i>
              <span class="point-label us" style="left:59%; bottom:84.5%">MemBukkit + gpt-5.4<br /><b>92.6%</b> · $0.015</span>

              <i class="point other" style="left:42%; bottom:67.1%"></i>
              <span class="point-label" style="left:29%; bottom:55.5%">Supermemory<br /><b>85.2%</b></span>

              <i class="point other" style="left:46.2%; bottom:36%"></i>
              <span class="point-label" style="left:41%; bottom:26%">Zep<br /><b>71.2%</b></span>

              <i class="point other" style="left:93.1%; bottom:11.6%"></i>
              <span class="point-label right" style="right:.5%; bottom:16%">full-context GPT-4o<br /><b>60.2%</b> · $0.29</span>

              <i class="point other" style="left:85.4%; bottom:76%"></i>
              <span class="point-label right" style="right:.5%; bottom:58%">Gemini 2.5 Pro full context<br /><b>89.2%</b> · $0.16</span>

              <i class="point altg" style="left:52.6%; bottom:87.6%"></i>
              <span class="point-label altg" style="left:30%; bottom:92%">Mem0 Cloud + GPT-5<br /><b>94.4%</b> · alternate judge</span>

              <i class="point altg" style="left:60.1%; bottom:80.9%"></i>
              <span class="point-label altg" style="left:63.5%; bottom:72%">Hindsight<br /><b>91.4%</b> · alternate judge</span>
            </div>
          </div>
          <div class="legend">
            <span><i class="us"></i>MemBukkit · official judge</span>
            <span><i class="other"></i>others · official judge</span>
            <span><i class="altg"></i>alternate judge</span>
          </div>
          <p class="bench-note">
            Query-time model list-price floors on measured answer context; write-time distillation
            and hidden reasoning tokens are excluded. <a href="/benchmarks/">Sources and protocol →</a>
          </p>
        </div>
      </div>

      <div class="paired-findings" aria-label="What MemBukkit's paired LongMemEval runs show">
        {pairedFindings.map((finding) => (
          <article>
            <b>{finding.value}</b>
            <span>{finding.label}</span>
            <p>{finding.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="quickstart">
    <div class="wrap quick-grid">
      <div class="sec-head">
        <span class="eyebrow" style="--hue:var(--amber)">try the showcase</span>
        <h2>See the distinction in one demo.</h2>
        <p>
          Run the personal-assistant demo, ask about rent in May and June, and inspect why the
          answer changes. The same local store powers the CLI and GUI.
        </p>
        <p class="first-run">
          First use needs an API key (or a local LLM), downloads model weights, and distills the
          bundled demo once. Later opens reuse the local store.
        </p>
      </div>
      <div class="terminal">
        <div class="terminal-head"><span></span><span></span><span></span><b>terminal</b></div>
        <pre><code><span class="comment"># clone and install</span>
<span class="prompt">$</span> git clone https://github.com/memseekai/membukkit
<span class="prompt">$</span> cd membukkit
<span class="prompt">$</span> pip install -e ".[all]"
<span class="prompt">$</span> export OPENAI_API_KEY=sk-...

<span class="comment"># open the explainability GUI with a bundled story</span>
<span class="prompt">$</span> membukkit ui --demo personal-assistant

<span class="comment"># or reproduce a low-cost benchmark smoke test</span>
<span class="prompt">$</span> membukkit bench --repro longmemeval-gpt4o-mini --lite</code></pre>
      </div>
    </div>
  </section>

  <section class="choose">
    <div class="wrap choose-inner">
      <div>
        <span class="eyebrow">where to go next</span>
        <h2>Explore with MemBukkit. Ship with Memseek.</h2>
        <p>
          Want to inspect agent memory, run a demo, or verify the benchmarks? Start with
          MemBukkit. Want the search method inside a governed context layer? Start with Memseek.
        </p>
      </div>
      <div class="choose-actions">
        <a class="btn btn-primary" href={repo}>Explore MemBukkit ↗</a>
        <a class="btn btn-ghost" href="/#quickstart">Run Memseek locally →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  section { padding-block: clamp(3.2rem, 7vw, 6rem); }
  .hero { position: relative; overflow: hidden; }
  .hero::before { content: ""; position: absolute; width: 50rem; height: 34rem; left: -18rem; top: -18rem; background: radial-gradient(circle, color-mix(in srgb, var(--green) 16%, transparent), transparent 70%); pointer-events: none; }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1fr .9fr; gap: clamp(2rem, 7vw, 6rem); align-items: center; }
  .name { display: flex; align-items: center; gap: 1rem; margin-top: 1.1rem; }
  .bucket-mark { display: grid; place-items: center; width: 3.4rem; height: 3.4rem; flex: none; border: 2px solid var(--green); border-radius: 13px 13px 19px 19px; color: var(--green); font-family: var(--mono); font-size: .75rem; font-weight: 700; box-shadow: inset 0 -8px 0 color-mix(in srgb, var(--green) 12%, transparent); transform: rotate(-2deg); }
  h1 { font-size: var(--step-3); }
  .tagline { margin-top: .65rem; color: var(--green); font-family: var(--mono); font-size: var(--step-1); font-weight: 700; }
  .lede { color: var(--muted); font-size: var(--step-1); line-height: 1.58; max-width: 60ch; margin-top: 1.15rem; }
  .lede b { color: var(--text); }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; margin-top: 1.6rem; }
  .license { margin-top: 1.1rem; color: var(--faint); font-family: var(--mono); font-size: .68rem; }

  .memory-card { background: var(--surface); border: 1px solid var(--border-strong); border-radius: 16px; padding: 1rem; box-shadow: var(--shadow); transform: rotate(.6deg); }
  .memory-top { display: flex; justify-content: space-between; gap: 1rem; color: var(--faint); font-family: var(--mono); font-size: .62rem; padding-bottom: .8rem; border-bottom: 1px solid var(--border); }
  .memory-top i { color: var(--green); font-style: normal; }
  .question { margin: 1rem 0 .75rem; font-family: var(--mono); font-size: .78rem; color: var(--muted); }
  .answer { border-left: 2px solid var(--orange); padding: .75rem 1rem; background: var(--bg); border-radius: 0 8px 8px 0; }
  .answer-label { display: block; color: var(--faint); font-family: var(--mono); font-size: .56rem; text-transform: uppercase; letter-spacing: .08em; }
  .answer b { display: block; margin-top: .25rem; font-family: var(--mono); font-size: 1.05rem; }
  .evidence { margin-top: .65rem; border: 1px solid var(--border); border-radius: 9px; padding: .7rem .8rem; }
  .evidence > span { font-family: var(--mono); font-size: .56rem; text-transform: uppercase; letter-spacing: .08em; }
  .evidence.current > span { color: var(--green); }
  .evidence.old > span { color: var(--amber); }
  .evidence p { font-size: .78rem; margin-top: .2rem; color: var(--text); }
  .evidence code { display: block; font-family: var(--mono); font-size: .58rem; color: var(--faint); margin-top: .25rem; }
  .evidence.old p { color: var(--muted); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--amber) 65%, transparent); }
  .receipt { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .8rem; }
  .receipt span { border: 1px solid var(--border); border-radius: 99px; padding: .2rem .5rem; color: var(--faint); font-family: var(--mono); font-size: .55rem; }

  .identity-section { background: var(--surface); border-block: 1px solid var(--border); }
  .identity-head { max-width: 48rem; margin-bottom: 2rem; }
  .identity-head h2 { font-size: var(--step-2); margin-top: .8rem; }
  .identity-grid { display: grid; grid-template-columns: 1fr 10rem 1fr; gap: 1rem; align-items: stretch; }
  .identity-card { border: 1px solid var(--border); border-radius: 14px; padding: 1.4rem; background: var(--bg); }
  .identity-card.product { border-top: 2px solid var(--orange); }
  .identity-card.showcase { border-top: 2px solid var(--green); }
  .identity-card .kind { font-family: var(--mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .12em; color: var(--faint); }
  .identity-card h3 { font-size: var(--step-1); margin-top: .45rem; }
  .identity-card p { color: var(--muted); font-size: var(--step--1); line-height: 1.55; margin-top: .65rem; }
  .identity-card a { display: inline-block; margin-top: .9rem; font-family: var(--mono); font-size: .72rem; }
  .shared { align-self: center; text-align: center; border: 1px dashed var(--cyan); border-radius: 50%; aspect-ratio: 1; display: grid; place-content: center; padding: .8rem; background: color-mix(in srgb, var(--cyan) 6%, var(--bg)); }
  .shared span, .shared small { color: var(--faint); font-family: var(--mono); font-size: .55rem; line-height: 1.35; }
  .shared b { color: var(--cyan); font-family: var(--mono); font-size: .78rem; margin-block: .25rem; }

  .sec-head { max-width: 64ch; margin-bottom: 2.2rem; }
  .sec-head h2 { font-size: var(--step-2); margin-top: .8rem; }
  .sec-head p { color: var(--muted); font-size: var(--step-1); line-height: 1.55; margin-top: .85rem; }
  .cap-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .8rem; }
  .cap { border: 1px solid var(--border); border-top: 2px solid var(--hue); border-radius: 12px; padding: 1.15rem; background: var(--surface); }
  .cap > span { color: var(--hue); font-family: var(--mono); font-size: .62rem; }
  .cap h3 { font-size: .92rem; margin-top: .7rem; }
  .cap p { color: var(--muted); font-size: .8rem; line-height: 1.5; margin-top: .45rem; }
  .method-strip { margin-top: 1.2rem; display: grid; grid-template-columns: 1fr 1fr auto; gap: 1.4rem; align-items: center; padding: 1.2rem; border: 1px solid color-mix(in srgb, var(--cyan) 42%, var(--border)); border-radius: 12px; background: color-mix(in srgb, var(--cyan) 5%, var(--surface)); }
  .mini-label { color: var(--cyan); font-family: var(--mono); font-size: .58rem; text-transform: uppercase; letter-spacing: .1em; }
  .method-strip h3 { font-size: .86rem; margin-top: .3rem; }
  .method-strip p { color: var(--muted); font-size: .76rem; line-height: 1.5; }
  .method-strip a { font-family: var(--mono); font-size: .68rem; white-space: nowrap; }

  .bench-section { background: linear-gradient(140deg, color-mix(in srgb, var(--green) 7%, var(--surface)), var(--surface)); border-block: 1px solid var(--border); }
  .bench-head { max-width: 66ch; margin-bottom: clamp(2rem, 5vw, 3.2rem); }
  .bench-head h2 { font-size: var(--step-2); margin-top: .8rem; }
  .bench-head h2 span { color: var(--green); font-size: 1.45em; font-variant-numeric: tabular-nums; }
  .bench-head > p { color: var(--muted); font-size: var(--step-1); line-height: 1.55; margin-top: .9rem; }
  .comparison-grid { display: grid; grid-template-columns: 1.05fr 1.3fr; gap: 1.1rem; align-items: start; }
  .benchmark-panel { min-width: 0; padding: 1.5rem 1.6rem; border: 1px solid var(--border); border-radius: 13px; background: var(--bg); box-shadow: var(--shadow); }
  .panel-title { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem; margin-bottom: 1.4rem; }
  .panel-title h3 { font-size: var(--step-1); }
  .panel-title > span { color: var(--green); font-family: var(--mono); font-size: var(--step--1); font-weight: 700; }

  .benchmark-row { display: grid; grid-template-columns: 11.5rem 1fr; gap: .85rem; align-items: center; margin-bottom: 1rem; }
  .row-label { color: var(--muted); font-family: var(--mono); font-size: .72rem; line-height: 1.35; }
  .row-label small { display: block; color: var(--faint); font-size: .62rem; font-style: normal; font-weight: 400; }
  .benchmark-row.us .row-label { color: var(--text); font-weight: 700; }
  .benchmark-row.altg .row-label { color: color-mix(in srgb, var(--rose) 78%, var(--muted)); font-style: italic; }
  .benchmark-row.altg .row-label small { color: color-mix(in srgb, var(--rose) 50%, var(--faint)); }
  .score-bar { position: relative; height: 22px; overflow: hidden; border-radius: 5px; background: var(--surface-2); }
  .score-bar > i { position: absolute; inset: 0; width: 100%; border-radius: 5px; clip-path: inset(0 calc(100% - var(--w) * 1%) 0 0 round 5px); }
  .score-bar.us > i { background: linear-gradient(90deg, var(--green), var(--cyan)); }
  .score-bar.other > i { background: var(--border-strong); }
  .score-bar.full > i { background: linear-gradient(90deg, color-mix(in srgb, var(--rose) 45%, var(--surface-2)), var(--rose)); }
  .score-bar.altg > i { background: repeating-linear-gradient(45deg, color-mix(in srgb, var(--rose) 30%, var(--surface-2)) 0 5px, var(--surface-2) 5px 11px); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--rose) 45%, transparent); }
  .score-bar b { position: absolute; right: .5rem; top: 50%; transform: translateY(-50%); color: var(--muted); font-family: var(--mono); font-size: .68rem; font-weight: 500; }
  .score-bar.us b { right: calc(100% - var(--w) * 1% + .55rem); color: #0a1510; font-weight: 700; }
  .score-bar.altg b { color: color-mix(in srgb, var(--rose) 80%, var(--muted)); font-style: italic; }

  .scatter-scroll { overflow: visible; }
  .scatter { position: relative; height: 500px; margin: 1.9rem 1rem 2.6rem 3rem; }
  .gridline-y { position: absolute; left: 0; right: 0; height: 1px; background: var(--border); }
  .gridline-y > span { position: absolute; left: -2.5rem; top: -.5em; color: var(--faint); font-family: var(--mono); font-size: .66rem; }
  .gridline-x { position: absolute; top: 0; bottom: -1.6rem; width: 1px; background: var(--border); }
  .gridline-x > span { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); color: var(--faint); font-family: var(--mono); font-size: .66rem; white-space: nowrap; }
  .gridline-x > small { position: absolute; top: -1.5rem; left: 50%; transform: translateX(-50%); color: var(--faint); font-family: var(--mono); font-size: .62rem; opacity: .75; white-space: nowrap; }
