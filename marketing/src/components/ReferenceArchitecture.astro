    border-radius: 18px;
    background:
      radial-gradient(circle at 50% 76%, color-mix(in srgb, var(--cyan) 8%, transparent), transparent 31%),
      var(--surface);
  }

  .architecture {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--mono);
  }

  .architecture--mobile { display: none; }

  .lane-label {
    fill: var(--faint);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .node rect {
