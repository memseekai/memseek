      </g>

      <g class="node node--world">
        <rect x="900" y="280" width="240" height="90" rx="18" />
        <text class="node-kicker" x="1020" y="312">WORLD MODEL</text>
        <text class="node-title" x="1020" y="342">predict consequences</text>
      </g>

      <g class="node node--memory">
        <rect class="memory-halo" x="340" y="460" width="520" height="195" rx="30" />
        <rect x="350" y="470" width="500" height="175" rx="25" />
