<figure class="wide reference-architecture">
  <div class="architecture-shell">
    <svg
      class="architecture architecture--desktop"
      viewBox="0 0 1200 700"
      role="img"
      aria-labelledby="architecture-title architecture-description"
    >
      <title id="architecture-title">A minimal memory-centered agent architecture</title>
      <desc id="architecture-description">
        A goal enters a meta-controller, then a generator proposes candidates and search selects
        among them with help from a world model. The selected action reaches the environment and a
        verifier judges the result. Failures return to the controller. Verified lessons enter
        memory, and memory supplies context to future runs.
      </desc>

      <defs>
        <marker id="runtime-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" />
