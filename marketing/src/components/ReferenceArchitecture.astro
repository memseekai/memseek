    font-weight: 700;
    letter-spacing: -.03em;
    text-anchor: middle;
  }

  .memory-copy {
    fill: var(--muted);
    font-size: 12px;
    text-anchor: middle;
  }

  .memory-emphasis {
    fill: var(--cyan);
    font-size: 13px;
    font-weight: 700;
    text-anchor: middle;
  }

  .runtime-edges,
  .mobile-runtime-edges,
  .model-edges,
  .mobile-model-edges,
  .memory-edges,
  .mobile-memory-edges {
    fill: none;
    stroke-linecap: round;
