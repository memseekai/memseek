    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .node--goal rect,
  .node--control rect {
    fill: color-mix(in srgb, var(--orange) 7%, var(--surface));
    stroke: color-mix(in srgb, var(--orange) 58%, var(--border));
  }

  .node--search rect,
