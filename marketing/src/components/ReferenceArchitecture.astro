        <rect x="70" y="600" width="230" height="100" rx="19" />
        <text class="node-kicker" x="185" y="635">ENVIRONMENT</text>
        <text class="node-title" x="185" y="670">observe</text>
      </g>

      <g class="node">
        <rect x="340" y="600" width="230" height="100" rx="19" />
        <text class="node-kicker" x="455" y="635">CRITICS / VERIFIERS</text>
        <text class="node-title" x="455" y="670">did it work?</text>
