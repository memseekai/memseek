  .runtime-edges {
    stroke: color-mix(in srgb, var(--orange) 78%, var(--muted));
    marker-end: url(#runtime-arrow);
  }

  .model-edges {
    stroke: color-mix(in srgb, var(--violet) 82%, var(--muted));
    marker-end: url(#model-arrow);
  }

  .memory-edges {
