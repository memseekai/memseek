        <marker id="model-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" />
        </marker>
        <marker id="memory-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" />
        </marker>
      </defs>

      <text class="lane-label" x="48" y="42">CURRENT TASK</text>

      <g class="runtime-edges">
        <path d="M230 125 H280" />
        <path d="M500 125 H550" />
        <path d="M770 125 H820" />
        <path d="M930 170 C930 230 675 220 675 280" />
        <path d="M580 325 H530" />
