      <text class="edge-label edge-label--memory" x="190" y="465">verified lesson</text>
      <text class="edge-label edge-label--memory" x="265" y="500" transform="rotate(-90 265 500)">retrieve next run</text>

      <g class="node node--goal">
        <rect x="50" y="80" width="180" height="90" rx="18" />
