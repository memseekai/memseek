---
/**
 * Blog-side nav. Mirrors the landing page header, but its section links are
 * absolute (/#why) so they work from a /blog/... URL.
 */
const { pathname } = Astro.url;
const onBlog = pathname.startsWith('/blog') || pathname.startsWith('/tags');
const onShowcase = pathname.startsWith('/showcase');
const onBenchmarks = pathname.startsWith('/benchmarks');
const onContextEngine = pathname.startsWith('/context-engine');
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="brand"><span class="dot"></span>memseek</a>
    <nav class="nav-links">
      <a href="/context-engine/" class="hide-sm" aria-current={onContextEngine ? 'page' : undefined}>Context engine</a>
      <a href="/#how" class="hide-sm">How it works</a>
      <a href="/#designs" class="hide-sm">Memory designs</a>
      <a href="/benchmarks/" class="hide-sm" aria-current={onBenchmarks ? 'page' : undefined}>Benchmarks</a>
      <a href="/showcase/" aria-current={onShowcase ? 'page' : undefined}>Showcases</a>
      <a href="/blog/" aria-current={onBlog ? 'page' : undefined}>Blog</a>
      <a href="https://github.com/memseekai/memseek" class="nav-gh" aria-label="Memseek on GitHub"><svg aria-hidden="true"><use href="#gh-mark" /></svg><span class="lbl">GitHub</span></a>
      <button class="theme-toggle" id="themeBtn" aria-label="Toggle color theme">THEME</button>
      <a href="/#waitlist" class="nav-cta">Join the waitlist</a>
    </nav>
  </div>
</header>
