---
import BrandMark from './BrandMark.astro';
import { DOCS_URL, REPO_URL } from '../lib/links';

interface Props {
  /** Reading surfaces (blog, showcases) offer the theme toggle; the
      marketing pages are light-only and pass 'light'. */
  theme?: 'light' | 'adaptive';
}
const { theme = 'light' } = Astro.props;

/** Marked current on an exact match and on anything below it, so a post
    keeps Blog underlined. */
const path = Astro.url.pathname;
const current = (href: string) => (path === href || path.startsWith(href) ? 'page' : undefined);
---

<header class="header">
  <div class="wrap nav">
    <a class="brand" href="/"><BrandMark /></a>

    <nav class="navlinks" id="navlinks" aria-label="Main navigation">
      <a href="/how-it-works/" aria-current={current('/how-it-works/')}>How it works</a>
      <a href="/benchmarks/" aria-current={current('/benchmarks/')}>Benchmarks</a>
      <a href="/blog/" aria-current={current('/blog/')}>Blog</a>
      <a href={DOCS_URL} target="_blank" rel="noopener noreferrer">Docs <span class="arrow" aria-hidden="true">↗</span></a>
      <a class="nav-gh" href={REPO_URL} target="_blank" rel="noopener noreferrer" aria-label="Memseek on GitHub">
        <svg aria-hidden="true" focusable="false"><use href="#gh-mark" /></svg>
      </a>
      {theme === 'adaptive' && (
        <button class="theme-toggle" id="themeBtn" type="button" aria-pressed="false">Theme</button>
      )}
      <a class="btn nav-cta" href="/start/">Try Memseek <span class="arrow" aria-hidden="true">↗</span></a>
    </nav>

    <a class="btn" href="/start/">Try Memseek <span class="arrow" aria-hidden="true">↗</span></a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="navlinks">Menu</button>
  </div>
</header>
