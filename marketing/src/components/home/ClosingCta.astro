---
import { CONTACT_URL } from '../../lib/links';
---

<section class="section wrap team-close" data-flow-field>
  <div>
    <h2>Help your company learn faster than the world changes.</h2>
    <p>Start with one task and the information your team already has.</p>
  </div>
  <div class="actions">
    <a class="btn" href="/start/">Get started <span class="arrow" aria-hidden="true">↗</span></a>
    <a class="textlink" href={CONTACT_URL} target="_blank" rel="noopener noreferrer">
      Talk through your workflow <span class="arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style is:global>
  .team-close {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    margin-bottom: 60px;
    padding: 55px 48px;
    border: 1px solid #c8d1ec;
    border-radius: 25px;
    background: linear-gradient(115deg, #edf2ff, #e1e6fb 58%, #e6dcf8);
    box-shadow: 0 18px 45px -30px #40579b55;
  }
  .team-close > div { position: relative; z-index: 1; }
  .team-close h2 { max-width: 650px; font-size: clamp(32px, 3.6vw, 51px); line-height: 1.1; letter-spacing: -.04em; }
  .team-close p { max-width: 480px; margin: 17px 0 0; font-size: 17px; line-height: 1.6; color: #4c6387; }
  .team-close .actions { flex-shrink: 0; }

  /* The flow field is painted once, for 4.5 seconds, on first entry. It is
     scenery: nothing reads it and nothing depends on it. */
  .hq-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    opacity: .14;
    mask-image: linear-gradient(90deg, transparent 12%, #000 80%);
  }

  @media (max-width: 1100px) {
    .team-close { display: block; padding: 40px 32px; }
    .team-close .actions { margin-top: 24px; }
  }
  @media (max-width: 760px) {
    .team-close { padding: 31px 24px; border-radius: 19px; margin-bottom: 35px; gap: 23px; }
    .team-close h2 { font-size: 33px; }
    .team-close p { font-size: 16px; }
    .team-close .actions { gap: 19px; }
    .hq-field { opacity: .18; }
  }
</style>
