---
import AppIcon from '../AppIcon.astro';
import SourceMessage from './SourceMessage.astro';
import { moments } from '../../data/customer-week';
---

{/* One account over one week. Frame 0 renders visible, so the card is
    readable with no JavaScript at all; customer-motion.ts takes over from
    there and hands control back on any interaction. */}
<aside
  class="customer-demo"
  id="customer-week"
  data-customer-demo
  data-demo-active="0"
  aria-label="Illustrative customer story: one account, one week"
>
  <div class="demo-heading">
    <b>Example: a customer renewal</b>
    <button class="demo-playback" type="button" data-demo-playback aria-label="Pause customer story">
      <span data-demo-play-symbol aria-hidden="true">Ⅱ</span>
      <span data-demo-play-label>Pause</span>
    </button>
  </div>

  <div class="demo-calendar" role="group" aria-label="Follow the account through the week">
    <div class="demo-calendar-line" aria-hidden="true"><span data-demo-progress></span></div>
    {moments.map((m, i) => (
      <button type="button" data-demo-day={i} aria-label={`Show ${m.day}: ${m.label}`} aria-pressed={i === 0}>
        <span class="demo-day-dot"></span>
        <b>{m.day}</b>
        <small>{m.date}</small>
      </button>
    ))}
  </div>

  <div class="demo-stage">
    {moments.map((m, i) => (
      <div class="demo-frame" data-demo-frame={i} data-action-flow={m.dispatch ? 'escalate' : undefined} hidden={i > 0}>
        <div class="demo-incoming">
          <div class="demo-paper paper-two" aria-hidden="true"></div>
          <div class="demo-paper paper-one" aria-hidden="true"></div>
          <SourceMessage record={m.source} />
        </div>

        <div class="demo-connection" aria-hidden="true">
          <span></span><i></i><small>{m.connection}</small>
        </div>

        <div class="demo-memory" data-action-origin={m.dispatch ? '' : undefined}>
          <div class="demo-memory-header">
            <span><AppIcon app="Memseek" /><b>Memseek</b></span>
            <span>{m.summaryLabel} <i>{m.version}</i></span>
          </div>
          <div class="demo-memory-content">
            <span class="demo-memory-eyebrow">{m.eyebrow}</span>
            <h2>{m.title}</h2>
            <p>{m.detail}</p>
            <div class="demo-evidence">
              {m.evidence.map((chip) => (
                <span class="demo-evidence-chip"><AppIcon app={chip.app} />{chip.label}</span>
              ))}
              <span class="demo-evidence-count">{m.count}</span>
            </div>
          </div>
          {m.next && (
            <div class="demo-next">
              <span>{m.next}</span>
              <b>{m.action}</b>
              <span aria-hidden="true">↗</span>
            </div>
          )}
        </div>

        {m.dispatch && (
          <>
            <div class="action-bridge"><span>Escalation + evidence</span></div>
            <div class="hero-dispatch" data-action-target>
              <div class="hero-dispatch-head">
                <span><AppIcon app={m.dispatch.app} /><b>{m.dispatch.channel}</b></span>
                <span class="action-receipt">
                  <span class="action-check" aria-hidden="true">✓</span> {m.dispatch.receipt}
                </span>
              </div>
              <div class="hero-dispatch-body">
                <span class={`demo-avatar avatar-${m.dispatch.app.toLowerCase()}`} aria-hidden="true">{m.dispatch.initial}</span>
                <p><b>{m.dispatch.lead}</b><br />{m.dispatch.body}</p>
              </div>
              <small>{m.dispatch.note}</small>
            </div>
          </>
        )}
      </div>
    ))}
  </div>

  <div class="demo-caption">
    <span>Illustrative workflow</span>
    <a href="#company-learning" data-jump>See the full example <span aria-hidden="true">↓</span></a>
  </div>
  <span class="demo-sr sr-only" data-demo-announcement aria-live="polite"></span>
</aside>

<style is:global>
  .customer-demo {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 550px;
    padding: 10px 0 0;
    isolation: isolate;
    color: var(--copy);
  }

  .demo-heading { display: flex; align-items: center; justify-content: space-between; padding: 0 4px 8px 14px; }
  .demo-heading > b { font-size: 16px; font-weight: 550; letter-spacing: -.02em; color: #233651; }

  .demo-playback {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 8px 10px;
    border: 0;
    border-radius: var(--r-xs);
    background: transparent;
    color: #56677e;
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  .demo-playback:hover { background: #eaf0fb; color: #244cbd; }
  [data-demo-play-symbol] { width: 12px; text-align: center; font-size: 13px; }

  /* ---------- the week ---------- */

  .demo-calendar { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); margin: 0 12px 19px; }
  .demo-calendar-line {
    position: absolute;
    left: 12.5%; right: 12.5%; top: 9px;
    height: 2px;
    overflow: hidden;
    background: #cbd7ef;
  }
  .demo-calendar-line > span {
    display: block;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, #6388ef, #405ede);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 900ms cubic-bezier(.2, .7, .1, 1);
  }
  .demo-calendar button {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 0 0 1px;
    border: 0;
    background: none;
    color: #8d99ad;
    font: inherit;
    cursor: pointer;
    transition: color .4s;
  }
  .demo-day-dot {
    width: 9px; height: 9px;
    margin: 6px 0 7px;
    border-radius: 50%;
    background: #d4deec;
    box-shadow: 0 0 0 5px #f4f7ff;
    transition: background .4s, box-shadow .4s;
  }
  .demo-calendar b { font-size: 14px; font-weight: 550; color: #61718b; }
  .demo-calendar small { display: none; font-size: 12px; color: #768199; }
  /* A past day stays legible, so the week reads as accumulated rather than
     as a carousel that discards what came before. */
  .demo-calendar button.is-past { color: #6680b1; }
  .demo-calendar button.is-past .demo-day-dot { background: #7196ef; }
  .demo-calendar button[aria-pressed='true'] { color: #3152c4; }
  .demo-calendar button[aria-pressed='true'] b { color: #1e4bd8; }
  .demo-calendar button[aria-pressed='true'] .demo-day-dot {
    background: #4b6ee7;
    box-shadow: 0 0 0 4px #e6ecff, 0 0 0 8px #f0f4ff;
  }
  .demo-playback:focus-visible, .demo-calendar button:focus-visible { outline: 2px solid #557bee; outline-offset: 4px; }

  /* ---------- a frame ---------- */

  /* A fixed stage height is what stops the page jumping as frames swap. */
  .demo-stage { position: relative; min-height: 440px; }
  .demo-frame[hidden] { display: none !important; }

  .demo-incoming { position: relative; z-index: 2; margin-left: 20px; }
  .demo-incoming .demo-message { min-height: 145px; }

  /* The stack behind the newest message: earlier records, still there. */
  .demo-paper {
    position: absolute;
    inset: 5px 8px -8px;
    z-index: -1;
    border: 1px solid #c5d4ec;
    border-radius: var(--r-lg);
    background: #dee8ff;
    transition: transform .7s;
  }
  .paper-one { transform: rotate(-1.1deg); }
  .paper-two { inset: 10px 16px -15px; background: #e3dcf6; border-color: #cdc7e7; transform: rotate(1.6deg); }
  .customer-demo[data-demo-active='0'] .paper-two { opacity: .35; }
  .customer-demo[data-demo-active='2'] .paper-one { transform: rotate(-2deg); }
  .customer-demo[data-demo-active='2'] .paper-two { transform: rotate(2deg); }

  .demo-message {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #cdd8eb;
    border-radius: var(--r-lg);
    background: #fffffff2;
    box-shadow: 0 1px 2px #243e5110, 0 14px 30px -18px #3f5d8c55;
    backdrop-filter: blur(16px);
  }
  .demo-app-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 16px;
    border-bottom: 1px solid #e1e7f2;
    background: #f7f9fce8;
    color: #65738b;
    line-height: 1.35;
  }
  .demo-app-header > span { display: flex; align-items: center; gap: 7px; min-width: 0; }
  .demo-app-header b { font-size: 13px; font-weight: 550; color: #344764; }
  .demo-app-header > span > span:last-child {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 12px;
    color: #6a7690;
  }
  .demo-app-header time { white-space: nowrap; font-size: 12px; color: #6a7690; }

  .demo-message-body { display: flex; align-items: flex-start; gap: 12px; padding: 13px 18px 15px; }
  .demo-avatar {
    display: grid;
    place-items: center;
    flex: 0 0 33px;
    width: 33px; height: 33px;
    border: 1px solid #d5e0f8;
    border-radius: var(--r);
    background: #e6edff;
    color: #3155a6;
    font-size: 14px;
    font-weight: 550;
  }
  .avatar-hubspot { background: #edf3fb; color: #5e7bac; }
  .avatar-slack { background: #f2edfb; color: #856cae; }
  .avatar-linear { background: #eef0ff; color: #6e75b4; }
  .demo-sender { display: flex; align-items: baseline; gap: 8px; margin: 1px 0 6px; line-height: 1.4; }
  .demo-sender b { font-size: 14px; font-weight: 600; color: #263b5b; }
  .demo-sender > span { font-size: 12px; color: #728098; }
  .customer-demo .demo-message p { margin: 0; font-size: 16px; line-height: 1.52; letter-spacing: -.008em; color: #394b66; }

  /* The wire from the message into memory. It carries a single lit node so
     the direction of travel is visible without animating anything. */
  .demo-connection {
    position: relative;
    display: flex;
    align-items: center;
    height: 36px;
    margin-left: 59px;
    padding-left: 17px;
  }
  .demo-connection > span {
    position: absolute;
    left: 0; top: 8px; bottom: 0;
    width: 2px;
    background: linear-gradient(#b7c8ec, #3863eb);
  }
  .demo-connection > i {
    position: absolute;
    left: -2px; top: 9px;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #7296f6;
    box-shadow: 0 0 7px #6e9bff;
  }
  .demo-connection small { padding-top: 6px; font-size: 12px; letter-spacing: .01em; color: #5873a7; }

  /* ---------- what Memseek holds ---------- */

  .demo-memory {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 260px;
    margin-right: 10px;
    overflow: hidden;
    border: 1px solid #b2c6f2;
    border-radius: 18px;
    background: linear-gradient(140deg, #fff 5%, #f7f9ff 60%, #e6edff);
    box-shadow: var(--shadow-raised);
    backdrop-filter: blur(16px);
  }
  .demo-memory::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(115deg, #ffffff45, transparent 30%);
  }
  .demo-memory-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 20px 8px; }
  .demo-memory-header > span:first-child { display: flex; align-items: center; gap: 7px; }
  .demo-memory-header b { font-size: 16px; font-weight: 600; color: #1d4fca; }
  .demo-memory-header > span:last-child { font-size: 12px; color: #61759d; }
  .demo-memory-header i { margin-left: 7px; font-style: normal; color: #a2b2cd; font-variant-numeric: tabular-nums; }

  .demo-memory-content { padding: 4px 21px 15px; }
  .demo-memory-eyebrow { display: block; margin-bottom: 9px; font-size: 12px; color: #5b7098; }
  .demo-memory h2 {
    max-width: 430px;
    margin: 0 0 10px;
    font-size: 27px;
    font-weight: 550;
    line-height: 1.14;
    letter-spacing: -.04em;
    color: #183e9d;
  }
  .customer-demo .demo-memory p { max-width: 430px; margin: 0; font-size: 15px; line-height: 1.5; color: #4c6389; }

  .demo-evidence { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; min-height: 23px; margin-top: 15px; }
  .demo-evidence-chip {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 7px;
    border: 1px solid #cbd8f1;
    border-radius: var(--r-xs);
    background: #ffffffe6;
    color: #405c8d;
    font-size: 12px;
    line-height: 1.4;
  }
  /* At 12px the mark inside a chip is noise; the word carries it. */
  .demo-evidence-chip .app-mark { display: none; }
  .demo-evidence-count { margin-left: auto; font-size: 12px; color: #687998; }

  .demo-next {
    display: grid;
    grid-template-columns: 1fr 18px;
    gap: 4px 10px;
    margin-top: auto;
    padding: 12px 20px 14px;
    border-top: 1px solid #c9d9f4;
    background: #e6efff;
  }
  .demo-next > span:first-child { grid-column: 1; font-size: 12px; color: #546c94; }
  .demo-next > b { grid-column: 1; font-size: 14px; font-weight: 500; line-height: 1.4; color: #314c7d; }
  .demo-next > span:last-child { grid-column: 2; grid-row: 1 / 3; align-self: center; font-size: 17px; color: #7891ce; }

  .demo-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 16px 10px 0;
    font-size: 12px;
    color: #6a7892;
  }
  .demo-caption a { color: #35589b; text-decoration: none; }
  .demo-caption a:hover { color: #3152c4; text-decoration: underline; text-underline-offset: 3px; }

  /* ---------- the one frame that dispatches ---------- */

  .action-bridge {
    position: relative;
    display: flex;
    align-items: center;
    height: 34px;
    margin-left: 37px;
    padding-left: 20px;
  }
  .action-bridge::before { content: ''; position: absolute; left: 0; inset-block: 0; border-left: 2px solid #b7a8ec; }
  .action-bridge::after {
    content: '';
    position: absolute;
    bottom: 3px; left: -3px;
    width: 6px; height: 6px;
    border-right: 2px solid #8b77d4;
    border-bottom: 2px solid #8b77d4;
    transform: rotate(45deg);
  }
  /* Once action-motion.ts has drawn the real wire, the CSS stand-in goes. */
  [data-action-enhanced] > .action-bridge::before,
  [data-action-enhanced] > .action-bridge::after { display: none; }
  .action-bridge > span { font-size: 11px; line-height: 1.3; color: #80709f; }

  .demo-frame[data-action-flow] .demo-memory { min-height: 0; }
  .demo-frame[data-action-flow] .demo-memory-content { padding-bottom: 13px; }
  .demo-frame[data-action-flow] .demo-evidence { margin-top: 11px; }

  .hero-dispatch {
    margin-left: 23px;
    overflow: hidden;
    border: 1px solid #cebfed;
    border-radius: var(--r-md);
    background: linear-gradient(110deg, #fff, #f8f4ff);
    box-shadow: 0 12px 22px -17px #8b6bc766;
  }
  .hero-dispatch-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 15px;
    border-bottom: 1px solid #e9e0f5;
  }
  .hero-dispatch-head > span:first-child { display: flex; align-items: center; gap: 6px; color: #7257a4; font-size: 12px; }
  .hero-dispatch-head b { font-weight: 550; }
  .hero-dispatch-head .action-receipt { padding: 0; border: 0; background: none; }
  .hero-dispatch-body { display: flex; align-items: center; gap: 9px; padding: 11px 15px 6px; }
  .customer-demo .hero-dispatch-body p { margin: 0; font-size: 13px; line-height: 1.5; color: #746786; }
  .hero-dispatch-body p > b { font-weight: 500; color: #665082; }
  .hero-dispatch > small { display: block; padding: 0 15px 10px 53px; font-size: 10px; color: #9a8daa; }

  .action-receipt { display: flex; align-items: center; gap: 6px; font-size: 12px; line-height: 1.4; color: #3b56a9; }
  .action-check {
    display: inline-grid;
    place-items: center;
    flex: 0 0 16px;
    width: 16px; height: 16px;
    border-radius: 50%;
    background: #6580d7;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
  }

  /* ---------- wires drawn by action-motion.ts ---------- */

  .action-wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 3; }
  .action-wire-base { fill: none; stroke: #b1c5ed; stroke-width: 2; }
  .action-wire-active { fill: none; stroke: #2c5ce6; stroke-width: 2.3; stroke-linecap: round; }
  .action-wire-tip { fill: none; stroke: #2c5ce6; stroke-width: 2.3; stroke-linecap: round; stroke-linejoin: round; }
  .action-wire-packet { fill: #4b82ff; stroke: #f6f3ff; stroke-width: 2; filter: drop-shadow(0 0 4px #427aff); }
  [data-action-waiting] > .action-wires { opacity: .2; }

  @media (min-width: 761px) and (max-width: 1100px) {
    .customer-demo { padding: 15px 0; }
    .demo-memory-header > span:last-child { font-size: 12px; }
    .demo-memory h2 { font-size: 25px; }
    .demo-incoming { margin-left: 18px; }
    .demo-memory { margin-right: 9px; }
    .demo-evidence-count { flex-basis: 100%; margin: 3px 0 0; }
  }

  @media (max-width: 760px) {
    .customer-demo { order: 2; width: 100%; max-width: 540px; margin: 20px auto 30px; padding-top: 0; }
    .demo-heading { padding: 0 0 13px 4px; }
    .demo-heading > b { font-size: 15px; }
    .demo-calendar { margin-inline: 5px; }
    .demo-calendar small { display: block; font-size: 12px; }
    .demo-incoming { margin-left: 11px; }
    .demo-incoming .demo-message { min-height: 162px; }
    .demo-stage { min-height: 490px; }
    .demo-app-header { padding: 10px 12px; gap: 5px; }
    .demo-app-header > span { gap: 5px; }
    .demo-app-header > span > span:last-child { max-width: 120px; }
    .demo-message-body { padding: 14px 13px 17px; gap: 9px; }
    .demo-sender { flex-wrap: wrap; gap: 3px 7px; }
    .customer-demo .demo-message p { font-size: 15px; line-height: 1.5; }
    .demo-memory { min-height: 278px; margin-right: 5px; }
    .demo-memory-header { padding: 14px 16px 10px; gap: 6px; }
    .demo-memory-header i { display: none; }
    .demo-memory-content { padding: 8px 17px 16px; }
    .demo-memory h2 { font-size: 26px; }
    .customer-demo .demo-memory p { font-size: 15px; }
    .demo-next { padding-inline: 17px; }
    .demo-evidence-count { flex-basis: 100%; margin: 3px 0 0; }
    .demo-caption { padding: 15px 3px 0; }
    .hero-dispatch { margin-left: 15px; }
    .hero-dispatch-body { padding-inline: 12px; }
    .hero-dispatch > small { padding-left: 48px; }
  }

  @media (max-width: 370px) {
    .demo-memory h2 { font-size: 23px; }
    .demo-memory-header > span:last-child { font-size: 11px; }
    .demo-sender { gap: 6px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .customer-demo * { animation: none !important; transition: none !important; }
  }
</style>
