---
import BrandMark from './BrandMark.astro';
import { DOCS_URL, REPO_URL, MEMBUKKIT_REPO_URL } from '../lib/links';
---

<footer class="footer">
  <div class="wrap footer-row">
    <div>
      <a class="brand" href="/"><BrandMark /></a>
      <p>Make intelligence compound.</p>
    </div>
    <div class="footer-links">
      <a href="/how-it-works/">How it works</a>
      <a href="/benchmarks/">Benchmarks</a>
      <a href="/blog/">Blog</a>
      <a href="/showcase/">Showcases</a>
      <a href={DOCS_URL} target="_blank" rel="noopener noreferrer">Docs <span aria-hidden="true">↗</span></a>
      <a class="gh" href={REPO_URL} target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" focusable="false"><use href="#gh-mark" /></svg>Memseek on GitHub <span aria-hidden="true">↗</span>
      </a>
      <a class="gh" href={MEMBUKKIT_REPO_URL} target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" focusable="false"><use href="#gh-mark" /></svg>MemBukkit on GitHub <span aria-hidden="true">↗</span>
      </a>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</footer>
