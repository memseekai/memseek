---
/**
 * The app marks used inside the demo cards and the graph engine node.
 *
 * These are simplified monochrome glyphs drawn in currentColor, not vendor
 * logos: they sit at 19px inside running text where a full-colour mark would
 * be illegible. The real brand SVGs live at /apps/ and are used only on the
 * org graph's source tiles, where they are large enough to read.
 */
export type Mark = 'Gmail' | 'HubSpot' | 'Slack' | 'Linear' | 'Memseek';

interface Props { app: Mark }
const { app } = Astro.props;
---

<span class={`app-mark app-${app.toLowerCase()}`} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="currentColor">
    {app === 'Gmail' && <path d="M3 6v13h4V9l5 4 5-4v10h4V6l-3-2-6 5-6-5Z" />}
    {app === 'HubSpot' && (
      <>
        <path d="M13.5 9.5 6 5M15 9V4M17 16l3 4M11 16l-5 4" fill="none" stroke="currentColor" stroke-width="2.1" />
        <circle cx="14" cy="13" r="4.5" fill="none" stroke="currentColor" stroke-width="2.1" />
        <circle cx="5" cy="4.5" r="2" /><circle cx="15" cy="3" r="1.7" />
        <circle cx="20.5" cy="21" r="1.7" /><circle cx="5" cy="21" r="1.7" />
      </>
    )}
    {app === 'Slack' && (
      <path d="M9 3v8M3 9h8M15 21v-8M21 15h-8M15 3v2M21 9h-2M9 21v-2M3 15h2" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
    )}
    {app === 'Linear' && (
      <>
        <path d="M3.3 12.5 11.5 20.7M3.6 7.1l13.3 13.3M7.1 3.6l13.3 13.3M12.5 3.3l8.2 8.2" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.2" />
      </>
    )}
    {app === 'Memseek' && (
      <path d="m3 5 6 4 6-4 6 4v10l-6-4-6 4-6-4Zm6 4v10m6-14v10" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    )}
  </svg>
</span>

<style is:global>
  .app-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 21px;
    width: 21px;
    height: 21px;
    color: #556ca1;
  }
  .app-mark svg { display: block; width: 19px; height: 19px; }
  .app-gmail { color: var(--app-gmail); }
  .app-hubspot { color: var(--app-hubspot); }
  .app-slack { color: var(--app-slack); }
  .app-linear { color: var(--app-linear); }
  .app-memseek { color: #4865df; }
</style>
