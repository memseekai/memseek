---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative image for og:image / twitter card. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Machine-readable dates for article pages. */
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Memseek" />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <link rel="alternate" type="application/rss+xml" title="Memseek blog" href={new URL('/rss.xml', Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* Applied before first paint so a light-theme reader never sees a dark flash. */}
    <script is:inline>
      try {
        var t = localStorage.getItem('ms-theme');
        if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>

  <body>
    <a href="#content" class="sr-only">Skip to content</a>
    <!-- The GitHub mark, defined once for the header and footer that reference it. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <symbol id="gh-mark" viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.1-.25-.36-1.07.08-2.2 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.13.18 1.95.08 2.2.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A7.995 7.995 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></symbol>
    </svg>
    <SiteHeader />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('themeBtn');
        if (btn) {
          btn.addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
            root.setAttribute('data-theme', next);
            try { localStorage.setItem('ms-theme', next); } catch (e) {}
          });
        }

        /* ===== nav menus — the landing page's behaviour, verbatim =====
           One open at a time, and the .open class is the only thing that opens
           a panel — hover included — so a pointer and a click can never
           disagree about what is showing. Closed panels are display:none, so
           their links stay out of the tab order until the menu is open. */
        var menus = Array.prototype.slice.call(document.querySelectorAll('.nav-menu'));
        if (!menus.length) return;
        var hoverable = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        var shut = null;

        function close(m) {
          m.classList.remove('open');
          m.querySelector('.nav-trigger').setAttribute('aria-expanded', 'false');
        }
        function closeAll(except) {
          menus.forEach(function (m) { if (m !== except) close(m); });
        }
        function open(m) {
          closeAll(m);
          m.classList.add('open');
          m.querySelector('.nav-trigger').setAttribute('aria-expanded', 'true');
        }

        menus.forEach(function (m) {
          var trigger = m.querySelector('.nav-trigger');
          trigger.addEventListener('click', function () {
            if (shut) { clearTimeout(shut); shut = null; }
            m.classList.contains('open') ? close(m) : open(m);
          });
          /* Selecting a destination is the end of the menu's job. */
          m.addEventListener('click', function (e) {
            if (e.target.closest('.nav-panel a')) close(m);
          });
          if (hoverable) {
            m.addEventListener('mouseenter', function () {
              if (shut) { clearTimeout(shut); shut = null; }
              open(m);
            });
            /* A moment's grace, so crossing the gap to the panel is not a miss. */
            m.addEventListener('mouseleave', function () {
              shut = setTimeout(function () { close(m); shut = null; }, 140);
            });
          }
          /* Tabbing out of the last item is a close, the same as clicking away. */
          m.addEventListener('focusout', function (e) {
            if (!m.contains(e.relatedTarget)) close(m);
          });
        });

        document.addEventListener('click', function (e) {
          if (!e.target.closest('.nav-menu')) closeAll(null);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape') return;
          var open_ = document.querySelector('.nav-menu.open');
          if (!open_) return;
          close(open_);
          open_.querySelector('.nav-trigger').focus();
        });
      })();
    </script>
  </body>
</html>
