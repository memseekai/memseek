{
  "name": "memseek-marketing",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "Memseek marketing site + blog (Astro, deployed as a Cloudflare Worker with static assets)",
  "scripts": {
    "dev": "node scripts/sync-chrome.mjs && astro dev",
    "build": "node scripts/sync-chrome.mjs && astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check && node scripts/check-tokens.mjs && node scripts/check-contrast.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12",
    "@astrojs/mdx": "^4.3.6",
    "@astrojs/rss": "^4.0.13",
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^5.16.2",
    "katex": "^0.16.25",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  }
}
